--pretrained_path Gaolaboratory/iona-base-100m
--train_dataset_repo chrisagrams/massive_kb_v1_shuffled
--eval_dataset_repo InstaDeepAI/ms_ninespecies_benchmark
--eval_split validation
--max_peaks 512
--pad_to_multiple_of 64
--preprocessing_num_workers 24
--run_name denovo-massivekb-100m
--output_dir ./runs/denovo-massivekb-100m
--freeze_encoder false
--decoder_hidden_size 512
--decoder_num_layers 6
--decoder_num_heads 8
--decoder_intermediate_size 2048
--decoder_dropout 0.1
--max_peptide_length 72
--max_charge 10
--learning_rate 3e-4
--lr_scheduler_type cosine
--warmup_steps 2000
--weight_decay 0.01
--adam_beta1 0.9
--adam_beta2 0.95
--max_grad_norm 1.0
--num_train_epochs 1
--per_device_train_batch_size 64
--per_device_eval_batch_size 64
--train_sampling_strategy group_by_length
--dataloader_num_workers 4
--bf16 true
--torch_compile true
--eval_strategy steps
--eval_steps 2000
--save_strategy steps
--save_steps 2000
--save_total_limit 3
--load_best_model_at_end true
--metric_for_best_model eval_peptide_recall
--greater_is_better true
--decode_rows 2000
--precursor_tolerance_ppm 50
--logging_steps 25
--logging_first_step true
--ddp_backend xccl
--ddp_find_unused_parameters false
--seed 0
--report_to wandb
