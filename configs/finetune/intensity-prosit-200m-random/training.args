--pretrained_path /flare/UIC-HPC/homes/cgrams/msdelta-runs/msdelta-200m-production-01/final
--data_dir /flare/UIC-HPC/homes/cgrams/prosit-dataset/arrays
--run_name intensity-prosit-200m-random
--output_dir ./runs/intensity-prosit-200m-random
--wandb_project msdelta-intensity
--random_init true
--freeze_encoder false
--head_hidden_size 256
--head_dropout 0.1
--prior_samples 2000000
--eval_samples 50000
--ion_pair_budget 174762
--ion_budget 5461
--learning_rate 1e-3
--encoder_learning_rate 3e-5
--lr_scheduler_type cosine
--warmup_steps 0.02
--weight_decay 0.01
--num_train_epochs 3
--per_device_eval_batch_size 16
--dataloader_num_workers 4
--bf16 true
--gradient_checkpointing true
--eval_strategy steps
--eval_steps 1000
--save_strategy steps
--save_steps 1000
--save_total_limit 2
--logging_steps 50
--ddp_backend xccl
--ddp_find_unused_parameters false
--seed 0
--data_seed 0
--report_to wandb
