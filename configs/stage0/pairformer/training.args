--config_name configs/stage0/pairformer
--processor_name_or_path configs/stage0/pairformer
--output_dir ./runs/p1s0-pairformer
--run_name p1s0-pairformer
--dataset_repo_id /lus/flare/projects/UIC-HPC/khuss/msdelta/data/stage0-cap150/raw
--dataset_train_split train
--dataset_validation_split validation
--preprocessing_num_workers 24
--max_peaks 150
--mask_ratio 0.50
--per_device_train_batch_size 32
--per_device_eval_batch_size 32
--gradient_accumulation_steps 2
--dataloader_num_workers 6
--learning_rate 1.3e-4
--adam_beta1 0.9
--adam_beta2 0.95
--lr_scheduler_type cosine
--warmup_steps 11
--max_steps 300
--weight_decay 0.01
--max_grad_norm 1.0
--bf16 true
--gradient_checkpointing true
--seed 0
--logging_steps 10
--logging_first_step true
--eval_strategy no
--save_strategy no
--remove_unused_columns false
--report_to wandb
--wandb_project msdelta-pretrain
--probe_execution off
--bias_curve_steps 0
--probe_steps 0
--denoise_steps 0
--retrieval_steps 0
--block_timing_steps 0
--block_timing_start_step 281
