--pretrained_path /flare/UIC-HPC/khuss/msdelta/pretrained/msdelta-100m-production-01-checkpoint-120000
--dataset_repo chrisagrams/ms-contrastive-100k
--max_peaks 512
--validation_fraction 0.1
--preprocessing_num_workers 24
--pooling mean+max
--temperature 0.002
--kl_weight 10
--groups_per_batch 170
--replicates 2
--run_name v2_allck-s100m_ck120k_lr4e-4_p170k2_seed0
--output_dir ./runs/v2_allck-s100m_ck120k_lr4e-4_p170k2_seed0
--learning_rate 4e-4
--lr_scheduler_type cosine
--warmup_steps 5
--weight_decay 0.01
--adam_beta1 0.9
--adam_beta2 0.95
--max_grad_norm 1.0
--num_train_epochs 3
--per_device_train_batch_size 8
--gradient_checkpointing false
--per_device_eval_batch_size 16
--dataloader_num_workers 4
--bf16 true
--eval_strategy no
--save_strategy steps
--save_steps 265
--save_total_limit 10
--logging_steps 10
--logging_first_step true
--remove_unused_columns false
--ddp_backend xccl
--ddp_find_unused_parameters false
--seed 0
--report_to wandb
--wandb_project msdelta-finetune-contrastive
--wandb_entity CS_Pharm
--dataset_format grouped
--include_consensus false
--exclude_replicate_peptides true
--gradcache_chunk 4
--save_only_model true
--split_seed 0
--gradcache_trim_padding true
--same_mass_batches true
--mass_jitter 1.0
