--dataset_repo chrisagrams/ms-contrastive-100k
--max_peaks 512
--validation_fraction 0.1
--preprocessing_num_workers 24
--pooling mean+max
--temperature 0.002
--kl_weight 10
--groups_per_batch 85
--replicates 3
--run_name finetune-contrastive-100k-50m
--output_dir ./runs/finetune-contrastive-100k-50m
--learning_rate 1e-4
--lr_scheduler_type cosine
--warmup_steps 5
--weight_decay 0.01
--adam_beta1 0.9
--adam_beta2 0.95
--max_grad_norm 1.0
--num_train_epochs 1
--per_device_train_batch_size 8
--per_device_eval_batch_size 16
--dataloader_num_workers 4
--bf16 true
--eval_strategy no
--save_strategy steps
--save_steps 300
--save_total_limit 10
--logging_steps 10
--logging_first_step true
--remove_unused_columns false
--ddp_backend xccl
--ddp_find_unused_parameters false
--seed 1
--report_to wandb
--dataset_format grouped
--include_consensus false
--exclude_replicate_peptides true
--gradcache_chunk 4
--save_only_model true
--split_seed 0
