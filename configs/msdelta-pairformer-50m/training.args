--config_name configs/msdelta-pairformer-50m
--model_class msdelta.model.experiments.pairformer.MSDeltaPairformerForPreTraining
--processor_name_or_path configs/msdelta-pairformer-50m
--output_dir ./runs/msdelta-pairformer-50m
--run_name msdelta-pairformer-50m
--dataset_repo_id chrisagrams/massive_kb_v1_shuffled
--dataset_train_split train
--dataset_validation_split val
--preprocessing_num_workers 24
--mask_ratio 0.50
--per_device_train_batch_size 32
--per_device_eval_batch_size 32
--gradient_accumulation_steps 8
--dataloader_num_workers 6
--learning_rate 1.3e-4
--adam_beta1 0.9
--adam_beta2 0.95
--lr_scheduler_type cosine
--warmup_steps 2000
--max_steps 56250
--weight_decay 0.01
--max_grad_norm 1.0
--bf16 true
--gradient_checkpointing true
--torch_compile false
--validation_batches 50
--seed 0
--logging_steps 50
--logging_first_step true
--eval_strategy steps
--eval_steps 500
--save_strategy steps
--save_steps 10000
--save_total_limit 3
--remove_unused_columns false
--report_to wandb
--wandb_project msdelta-pretrain
--bias_curve_steps 5000
--probe_steps 5000
--probe_num_spectra 3000
--denoise_steps 0
--denoise_dataset_repo chrisagrams/ms-denoise-100k
--denoise_max_peaks 1024
--denoise_peak_pair_budget 4194304
--denoise_intensity_threshold_frac 0.0
--deepspeed configs/deepspeed-zero2.json
