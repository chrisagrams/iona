--pretrained_path /flare/UIC-HPC/khuss/msdelta/pretrained/msdelta-400m-production-01-checkpoint-220000
--dataset_repo chrisagrams/ms-contrastive-100k
--max_peaks 512
--validation_fraction 0.1
--preprocessing_num_workers 24
--run_name a1-align-100k-400m-frozen220k
--output_dir ./runs/a1-align-100k-400m-frozen220k
--pooling mean+max
--sequence_hidden_size 256
--sequence_num_layers 4
--sequence_num_heads 8
--sequence_dropout 0.1
--max_peptide_length 64
--learning_rate 1e-3
--lr_scheduler_type cosine
--warmup_steps 200
--weight_decay 0.01
--adam_beta1 0.9
--adam_beta2 0.95
--max_grad_norm 1.0
--num_train_epochs 3
--per_device_train_batch_size 64
--per_device_eval_batch_size 64
--dataloader_num_workers 4
--bf16 true
--eval_strategy steps
--eval_steps 1000
--save_strategy steps
--save_steps 1000
--save_total_limit 3
--load_best_model_at_end true
--metric_for_best_model eval_loss
--greater_is_better false
--logging_steps 25
--logging_first_step true
--remove_unused_columns false
--ddp_backend xccl
--ddp_find_unused_parameters false
--eval_alignment_rows 2000
--seed 0
--report_to wandb
--wandb_project msdelta-finetune-align
--wandb_entity CS_Pharm
--dataset_format grouped
--include_consensus false
--exclude_replicate_peptides true
