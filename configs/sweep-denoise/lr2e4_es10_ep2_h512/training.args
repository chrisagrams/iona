--pretrained_path /flare/UIC-HPC/homes/cgrams/msdelta-runs/msdelta-50m-production-01/final
--dataset_repo chrisagrams/ms-denoise-100k
--max_peaks 512
--preprocessing_num_workers 24
--run_name dn50m-lr2e4_es10_ep2_h512
--output_dir ./runs/dn50m-lr2e4_es10_ep2_h512
--freeze_encoder_steps 500
--encoder_lr_scale 1.0
--head_hidden_size 512
--head_dropout 0.1
--learning_rate 2e-4
--lr_scheduler_type cosine
--warmup_steps 500
--weight_decay 0.01
--adam_beta1 0.9
--adam_beta2 0.95
--max_grad_norm 1.0
--num_train_epochs 2
--peak_pair_budget 1048576
--per_device_train_batch_size 4
--per_device_eval_batch_size 4
--dataloader_num_workers 4
--bf16 true
--eval_strategy steps
--eval_steps 500
--save_strategy steps
--save_steps 500
--save_total_limit 3
--load_best_model_at_end true
--metric_for_best_model eval_auprc
--greater_is_better true
--logging_steps 50
--logging_first_step true
--remove_unused_columns false
--label_names labels
--ddp_backend xccl
--ddp_find_unused_parameters false
--seed 0
--report_to wandb
--wandb_project msdelta-finetune
--wandb_entity CS_Pharm
