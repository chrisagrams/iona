--config_name configs/iona-base-50m
--processor_name_or_path configs/iona-base-50m
--output_dir ./runs/iona-base-50m
--run_name iona-base-50m
--dataset_repo_id chrisagrams/MSConsensus-100M
--dataset_train_split train
--dataset_validation_split validation
--preprocessing_num_workers 24
--mask_ratio 0.50
--pad_to_multiple_of 64
--train_sampling_strategy group_by_length
--per_device_train_batch_size 64
--per_device_eval_batch_size 8
--gradient_accumulation_steps 4
--dataloader_num_workers 4
--learning_rate 1.3e-4
--adam_beta1 0.9
--adam_beta2 0.95
--lr_scheduler_type cosine
--warmup_steps 2000
--num_train_epochs 3
--weight_decay 0.01
--max_grad_norm 1.0
--bf16 true
--torch_compile true
--logarithmic_eval_start_step 500
--seed 0
--logging_steps 50
--logging_first_step true
--eval_strategy no
--save_strategy steps
--save_steps 10000
--remove_unused_columns false
--report_to wandb
--wandb_project iona-pretrain
--bias_curve_steps 5000
--probe_steps 5000
--probe_num_spectra 3000
--probe_batch_size 1
--replicate_retrieval_repo chrisagrams/ms2-peptide-replicate-retrieval
--retrieval_steps 10000
--retrieval_dataset_repo chrisagrams/ms-contrastive-100k
--retrieval_per_device_batch_size 2
--denoise_steps 10000
--denoise_dataset_repo chrisagrams/ms-denoise-100k
--denoise_max_peaks 1024
--denoise_peak_pair_budget 4194304
--deepspeed configs/deepspeed-zero2.json
