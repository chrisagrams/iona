--pretrained_path /flare/UIC-HPC/homes/cgrams/msdelta-runs/msdelta-50m-production-01/final
--dataset_repo chrisagrams/ms2-peptide-replicate-retrieval
--max_peaks 512
--validation_fraction 0.1
--preprocessing_num_workers 24
--pooling mean+max
--temperature 0.07
--kl_weight 100.0
--groups_per_batch 2
--replicates 2
--run_name contrastive-50m
--output_dir ./runs/contrastive-50m
--learning_rate 2e-5
--lr_scheduler_type cosine
--warmup_steps 100
--weight_decay 0.01
--adam_beta1 0.9
--adam_beta2 0.95
--max_grad_norm 1.0
--num_train_epochs 3
--per_device_train_batch_size 8
--gradient_checkpointing true
--per_device_eval_batch_size 16
--dataloader_num_workers 4
--bf16 true
--eval_strategy no
--save_strategy steps
--save_steps 200
--save_total_limit 2
--logging_steps 10
--logging_first_step true
--remove_unused_columns false
--ddp_backend xccl
--ddp_find_unused_parameters false
--seed 0
--report_to wandb
--wandb_project msdelta-finetune-contrastive
--wandb_entity CS_Pharm
