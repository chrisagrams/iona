#!/bin/bash -l
# Score MODELS on the nine-species yeast 20k subset (built by nine_diag.pbs).
#PBS -N c16-nine
#PBS -A UIC-HPC
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o /home/khuss/code/msdelta/pbs/logs/
set -uo pipefail
cd /home/khuss/code/msdelta
S=/lus/flare/projects/UIC-HPC/khuss/msdelta; D=$S/baselines/nine_yeast20k
MODELS=${MODELS:?set MODELS}
source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/lib/load_frameworks.sh"
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZE_FLAT_DEVICE_HIERARCHY=FLAT PYTHONPATH=$PWD OMP_NUM_THREADS=8
export HF_HOME=$S/huggingface HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
[ -d $D/prepared ] || { echo "subset missing: $D"; exit 1; }
OUT=results/raw/finetune/contrastive/nine20k; mkdir -p $OUT
n=$(grep -cv '^#' $MODELS); pids=()
for i in $(seq 0 $((n - 1))); do
  ZE_AFFINITY_MASK=$i .venv/bin/python -m msdelta.eval_grouped_retrieval score --data $D/prepared \
    --models $MODELS --out-dir $OUT --shard $i --num-shards $n > $OUT/.c16_shard$i.log 2>&1 & pids+=($!)
done
for p in "${pids[@]}"; do wait $p || echo "a shard failed"; done
grep -h "MAP@R\|Error" $OUT/.c16_shard*.log | cut -c1-140
