#!/bin/bash -l
# A on unseen data: cross-modal spectrum -> peptide on the C11 set (HEK/HCT116 confident
# PSMs; neither our models nor yHydra trained on it). Ours: A1, 3 seeds. yHydra: pretrained.
# Needs the C11 build ($C/prepared, $C/export). Same scorer as the in-distribution run.
#PBS -N c11-xmodal
#PBS -A UIC-HPC
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o /home/khuss/code/msdelta/pbs/logs/
set -uo pipefail
cd /home/khuss/code/msdelta
S=/lus/flare/projects/UIC-HPC/khuss/msdelta
C=${C11_DIR:-$S/baselines/c11_cap20}; OUT=$C/xmodal; mkdir -p $OUT
CACHE=${CACHE:-$S/align-targets-a1-050m-c7s600}
ARGS=${ARGS:-configs/a1-align-100k-050m-c7s600/training.args}
RUNS=${RUNS:-"$S/runs/v2_align-ft-a1-align-100k-050m-c7s600-8861093 $S/runs/v2_align-ft-a1-align-100k-050m-c7s600-8861292 $S/runs/v2_align-ft-a1-align-100k-050m-c7s600-8861309"}
[ -f $C/export/meta.parquet ] || { echo "C11 build missing"; exit 1; }
set +u; source /usr/share/lmod/lmod/init/bash; module load frameworks/2025.3.1; set -u
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZE_FLAT_DEVICE_HIERARCHY=FLAT PYTHONPATH=$PWD OMP_NUM_THREADS=8
export HF_HOME=$S/huggingface HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
echo "=== $(date -Is) yHydra spectrum tower (CPU, background)"
( [ -f $C/export/yhydra_embed.npy ] || env -u PYTHONPATH CUDA_VISIBLE_DEVICES="" TF_CPP_MIN_LOG_LEVEL=2 \
    $S/baselines/yhydra/env/bin/python baselines_wip/gleams/embed_yhydra.py $C/export > $OUT/yhydra_embed.log 2>&1 ) &
ypid=$!
echo "=== $(date -Is) ours (A1 x3)"
i=0; pids=()
for run in $RUNS; do
  n=$(basename $run)
  [ -f $OUT/$n.npz ] && { i=$((i + 1)); continue; }
  ZE_AFFINITY_MASK=$i .venv/bin/python -m msdelta.eval_align_test --run $run --cache $CACHE \
    --args_file $ARGS --data $C/prepared --out $OUT/test_$n.json --save-embeddings $OUT/$n.npz \
    > $OUT/.ours_$n.log 2>&1 &
  pids+=($!); i=$((i + 1))
done
for p in "${pids[@]}"; do wait $p || echo "OURS FAILED (see $OUT/.ours_*.log)"; done
wait $ypid; tail -2 $OUT/yhydra_embed.log
echo "=== $(date -Is) comparison"
for run in $RUNS; do
  n=$(basename $run)
  env -u PYTHONPATH CUDA_VISIBLE_DEVICES="" TF_CPP_MIN_LOG_LEVEL=2 \
    $S/baselines/yhydra/env/bin/python baselines_wip/yhydra_crossmodal.py $C/export $OUT/$n.npz $OUT/xmodal_$n.json \
    2>&1 | grep -v "Warning\|warn\|WARNING" | tail -14
done
echo "=== $(date -Is) done"
