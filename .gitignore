# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Run artifacts
runs/
wandb/
pbs/logs/

# data/ holds only preparation scripts and docs; the data itself lives on /flare (see data/README.md)
data/*
!data/*.py
!data/*.sh
!data/*.md

# Credentials: loaded at runtime by pbs/load_keys.sh, never committed
.keys
.keys/

# process core dumps
core.[0-9]*
.venv-2026/
# K198a (notes/AGENT_PLAYBOOK_2.md C7): results/ takes only Markdown and plots; data goes to the homes in
# configs/homes.env. Files already tracked under results/raw|processed stay tracked until K198b.
/results/**
!/results/**/
!/results/**/*.md
!/results/**/*.png
!/results/**/*.svg
