# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Run artifacts
runs/
wandb/
pbs/logs/

# Benchmark data (published to HF, not tracked in git)
data/

# Sweep arm configs are generated by sweeps/make_*.py and verified against their
# generator by the GRID_CHECK guard in pbs/aurora-finetune-sweep.pbs before any job
# runs, so checking them in adds 14k lines of machine output that nothing reads and
# that cannot drift undetected. Regenerate with e.g.
#   python sweeps/make_denoise_grid.py --stage full+backup --clean
configs/sweep-*/*/
