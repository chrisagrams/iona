#!/bin/bash -l
# Score saved contrastive encoders on ms-contrastive-100k's held-out split. No training.
#
#   qsub -q debug -l select=1 -l walltime=01:00:00 \
#        -v MODELS=models.txt,DATASET=chrisagrams/ms-contrastive-100k,PROCESSOR=/path/to/ckpt scripts/eval_grouped_retrieval.pbs
#
# Prepares the split once, then scores one shard of models per tile. Resubmit to resume.

#PBS -N iona-evalgrp
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
MODELS=${MODELS:?set MODELS to a models file}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
PROJECT=${PROJECT:-UIC-HPC}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/$PROJECT/$USER/msdelta}
SPLIT=${SPLIT:-test}
DATA=${DATA:-$SCRATCH_ROOT/eval-data/ms-contrastive-100k-$SPLIT-mp512}
OUT_DIR=${OUT_DIR:-results/finetune/contrastive/grouped100k-$SPLIT}
SHARDS=${SHARDS:-12}

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u

export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}
PY="$VENV_DIR/bin/python"

if [[ ! -d $DATA ]]; then
    echo "=== $(date -Is) prepare $DATA"
    mkdir -p "$(dirname "$DATA")"
    ZE_AFFINITY_MASK=0 "$PY" "$REPO_DIR/scripts/eval_grouped_retrieval.py" prepare \
        --out-data "$DATA" --repo "${DATASET:?set DATASET to the grouped dataset repo}" \
        --processor "${PROCESSOR:?set PROCESSOR to a checkpoint to take the processor config from}" \
        --split "$SPLIT" ${EXCLUDE_PEPTIDES_FROM:+--exclude-peptides-from "$EXCLUDE_PEPTIDES_FROM"} \
        || { echo "prepare failed" >&2; exit 1; }
fi
cat "$DATA/PREPARED.json"

echo "=== $(date -Is) score on $SHARDS tiles"
mkdir -p "$OUT_DIR"
pids=()
for (( i = 0; i < SHARDS; i++ )); do
    ZE_AFFINITY_MASK=$i "$PY" "$REPO_DIR/scripts/eval_grouped_retrieval.py" score \
        --data "$DATA" --models "$MODELS" --out-dir "$OUT_DIR" \
        --shard "$i" --num-shards "$SHARDS" > "$OUT_DIR/.shard$i.log" 2>&1 &
    pids+=($!)
done
failed=0
for i in "${!pids[@]}"; do
    wait "${pids[$i]}" || { echo "  shard $i failed:"; tail -5 "$OUT_DIR/.shard$i.log"; failed=1; }
done
cat "$OUT_DIR"/.shard*.log | grep -E "MAP@R|skipping|Error" || true

echo "=== $(date -Is) table"
"$PY" - "$OUT_DIR" "$MODELS" <<'EOF'
import json, sys
from pathlib import Path
out, models = Path(sys.argv[1]), sys.argv[2]
names = [l.split()[0] for l in Path(models).read_text().splitlines()
         if l.strip() and not l.startswith("#")]
print(f"{'model':38s} {'all MAP@R':>9s} {'exp MAP@R':>9s} {'exp Hit@1':>9s} {'queries':>8s}")
for n in names:
    f = out / f"{n}.json"
    if not f.exists():
        print(f"{n:38s} {'(missing)':>9s}"); continue
    m = json.loads(f.read_text())["metrics"]
    print(f"{n:38s} {m['all/MAP@R']:9.4f} {m['experimental/MAP@R']:9.4f} "
          f"{m['experimental/Hit@1']:9.4f} {int(m['experimental/queries']):8d}")
EOF
exit $failed
