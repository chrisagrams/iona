#!/bin/bash -l
# Build the de novo splits and download the encoder checkpoint with one non-distributed process.
# Everything is stored under HF_HOME so it can be copied to DAOS for scripts/aurora-finetune.pbs.
# Submit from the repository root, for example:
# qsub -A PROJECT -q QUEUE \
#   -l select=1 -l walltime=02:00:00 \
#   -l filesystems=home:flare -j oe -o /path/to/pbs/logs \
#   -v ARGS_FILE=configs/finetune/denovo-massivekb-50m/training.args,HF_HOME=/flare/UIC-HPC/homes/cgrams/hf \
#   scripts/aurora-preprocess-denovo.pbs
# The splits go to $HF_HOME/datasets/denovo-preprocessed unless PREPROCESSED_DATASET_DIR is set.

module load frameworks/2026.1.0

set -euo pipefail

REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
ARGS_FILE=${ARGS_FILE:?set ARGS_FILE to a de novo finetune args file}
HF_HOME=${HF_HOME:?set HF_HOME to an absolute shared-filesystem path}
DATASET_CACHE_DIR=${DATASET_CACHE_DIR:-$HF_HOME/datasets}
PREPROCESSED_DATASET_DIR=${PREPROCESSED_DATASET_DIR:-$DATASET_CACHE_DIR/denovo-preprocessed}
NUM_PROC=${NUM_PROC:-64}

if [[ $ARGS_FILE != /* ]]; then
    ARGS_FILE=$REPO_DIR/$ARGS_FILE
fi
if [[ $HF_HOME != /* || $DATASET_CACHE_DIR != /* || $PREPROCESSED_DATASET_DIR != /* ]]; then
    echo "HF_HOME and dataset paths must be absolute shared-filesystem paths" >&2
    exit 2
fi
if [[ ! -f $ARGS_FILE ]]; then
    echo "arguments file not found: $ARGS_FILE" >&2
    exit 2
fi
if [[ ! -x $VENV_DIR/bin/python ]]; then
    echo "Python interpreter not found: $VENV_DIR/bin/python" >&2
    exit 2
fi

mkdir -p "$DATASET_CACHE_DIR"
cd "$REPO_DIR"

export HF_HOME
export HF_DATASETS_CACHE=$DATASET_CACHE_DIR
export HF_HUB_CACHE=$HF_HOME/hub
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-0}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-0}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-1}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-1}
# Python multiprocessing binds AF_UNIX sockets under TMPDIR, which must stay
# well under the 107-byte socket path limit; the PBS job TMPDIR can exceed it.
export TMPDIR=${IONA_TMPDIR:-/tmp}

ALCF_PROXY=${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTP_PROXY=${HTTP_PROXY:-$ALCF_PROXY}
export HTTPS_PROXY=${HTTPS_PROXY:-$ALCF_PROXY}
export http_proxy=${http_proxy:-$ALCF_PROXY}
export https_proxy=${https_proxy:-$ALCF_PROXY}
export ftp_proxy=${ftp_proxy:-$ALCF_PROXY}
export no_proxy=${no_proxy:-admin,localhost,*.cm.aurora.alcf.anl.gov,aurora-*,*.aurora.alcf.anl.gov,*.alcf.anl.gov}
export NO_PROXY=${NO_PROXY:-$no_proxy}

echo "$(date -Is) preprocessing de novo hf_home=$HF_HOME args=$ARGS_FILE out=$PREPROCESSED_DATASET_DIR num_proc=$NUM_PROC"
exec "$VENV_DIR/bin/python" "$REPO_DIR/scripts/preprocess_denovo.py" \
    --args_file "$ARGS_FILE" \
    --preprocessed_dataset_dir "$PREPROCESSED_DATASET_DIR" \
    --preprocessing_num_workers "$NUM_PROC"
