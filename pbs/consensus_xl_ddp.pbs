#!/bin/bash
#PBS -N consensus_xl
#PBS -A FRAME-IDP
#PBS -q preemptable
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=24:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# Train XL (d=1024) on the shuffled CONSENSUS corpus with 4-way DDP (one process
# per A100-40GB on one Polaris node via torchrun). Reads the shuffled shards
# LOCALLY from eagle (data.root) — no HF download for the training data. The HF
# cache is still wired up for the inline replicate-retrieval probe only.
#
# Config selected by env (override with `qsub -v`):
#   FULL (default):    configs/consensus_xl.yaml       (~109M train, 340k steps,
#                      ~30 h → needs resume to finish a full epoch)
#   MASSIVEKB-MATCHED: qsub -v CFG=configs/consensus_xl_28M.yaml pbs/consensus_xl_ddp.pbs
#                      (~28.5M train, 90k steps ≈ 1 epoch, ~8 h — fits this walltime)
#
# Pre-reqs (run ONCE): pbs/setup_venv.sh; pbs/shuffle_consensus.sh (builds the
# shuffled dir this config points at); pbs/download_hf_dataset.sh (caches the
# probe benchmark onto eagle).

set -euo pipefail

REPO=/home/cgrams/msdelta
VENV=$REPO/.venv
CFG=${CFG:-configs/consensus_xl.yaml}
case "$CFG" in /*) ;; *) CFG="$REPO/$CFG" ;; esac
TAG=$(basename "$CFG" .yaml)

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
RUN_NAME=${TAG}_${JOBID}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

cd "$REPO"
echo "$(date -Is) job=$PBS_JOBID host=$(hostname) gpus=$(nvidia-smi -L | wc -l) run=$RUN_NAME cfg=$CFG"
nvidia-smi -L | sed "s/^/  /"

# 4 ranks share the node's hardware threads; leave headroom for the 6
# dataloader workers each rank spawns.
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# Fragmentation fix for the inline probe forwards on the big tier (see train.py).
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# HF cache on eagle (probe benchmark only — training data is local). OFFLINE=1
# resolves the probe from the pre-fetched cache with no per-rank network hit.
export HF_HOME=/eagle/UIC-HPC/cgrams/hf_cache
export HF_HUB_OFFLINE=1

# ALCF proxy for rank-0 wandb; keep loopback/cluster traffic (NCCL rendezvous
# on 127.0.0.1 for --standalone) off the proxy.
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY=$http_proxy HTTPS_PROXY=$https_proxy
export no_proxy=localhost,127.0.0.1,.alcf.anl.gov,.anl.gov
export NO_PROXY=$no_proxy

export WANDB_DIR=$LOGDIR
export WANDB_RESUME=allow
export WANDB_RUN_ID=$RUN_NAME

# torchrun spawns one process per GPU; train.py reads RANK/WORLD_SIZE/LOCAL_RANK
# from the env and initialises the NCCL process group.
exec "$VENV/bin/torchrun" \
    --standalone --nnodes=1 --nproc_per_node=4 \
    -m msdelta.train \
    --config "$CFG" \
    --run-name "$RUN_NAME" \
    >"$LOGDIR/${TAG}.out" 2>"$LOGDIR/${TAG}.err"
