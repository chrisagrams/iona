#!/bin/bash
#PBS -N msdelta_v14xl
#PBS -A FRAME-IDP
#PBS -q capacity
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=12:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# v14 XL — standalone resume. The XL tier (d=1024) of the v14 capacity
# sweep reached step 80000/160000 before its parent job (7174804) ended;
# its manual in-node resume ran fine to step 85200 (the empty_cache +
# expandable_segments OOM fix WORKS — probes fired clean, no OOM) but was
# torn down when S/M/L finished and PBS reclaimed the node. This job
# finishes XL on its own allocation, resuming from last.pt (step 80000).
#
# Single A100 (GPU 0); Polaris allocates the whole node but we only need
# one GPU for one tier. ~80k steps remain at ~3.45 sps ≈ 6.5h compute +
# inline-probe overhead; 12h walltime is comfortable margin.
#
# Rejoins the SAME wandb run (v14_cap_XL_7174804) via resume_run.sh
# (WANDB_RESUME=allow + WANDB_RUN_ID), so the trajectory continues in
# place. Re-logged steps 80001..85200 (already on wandb from the manual
# resume) are dropped as non-monotonic; new points continue past 85200.
#
# Pre-req: pbs/setup_venv.sh run once on the login node.

set -euo pipefail

REPO=/home/cgrams/msdelta
RUN_DIR=/eagle/UIC-HPC/cgrams/msdelta-runs/v14_cap_XL_7174804
cd "$REPO"

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
echo "$(date -Is) job=$PBS_JOBID host=$(hostname) — resuming XL from $RUN_DIR/last.pt"
nvidia-smi -L | sed "s/^/  /"

# resume_run.sh: splices data.root + out_dir, sets the proxy + the OOM fix
# (PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True), rejoins the wandb run,
# and execs msdelta-train --resume. Logs to pbs/logs/resume_<run>/.
bash "$REPO/pbs/resume_run.sh" configs/v14_cap_XL.yaml 0 "$RUN_DIR"
rc=$?
echo "$(date -Is) v14_cap_XL resume exit=$rc"
exit $rc
