#!/bin/bash
#PBS -N mkb_ddp
#PBS -A FRAME-IDP
#PBS -q preemptable
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=12:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# Train the XL architecture on MassIVE-KB with 2-way DistributedDataParallel
# (two A100-40GB GPUs on a single Polaris node) via torchrun. Unlike
# scale_all.pbs (4 *independent* models, one per GPU), this is ONE model whose
# gradients are all-reduced across 2 GPUs each step — global batch 512
# (64/GPU × 2 × 4 accum), matching W&B run qvcw35rr.
#
# Pre-reqs: pbs/setup_venv.sh once; pbs/convert_massivekb.sh once (writes the
# globally-shuffled parquet that configs/massivekb_xl.yaml points at).

set -euo pipefail

REPO=/home/cgrams/msdelta
VENV=$REPO/.venv
CFG=$REPO/configs/massivekb_xl.yaml

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
RUN_NAME=massivekb_xl-polaris-gbs512-${JOBID}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

cd "$REPO"
echo "$(date -Is) job=$PBS_JOBID host=$(hostname) gpus=$(nvidia-smi -L | wc -l) run=$RUN_NAME"
nvidia-smi -L | sed "s/^/  /"

# 2 ranks share the node's 64 hardware threads; leave headroom for the 6
# dataloader workers each rank spawns.
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# Fragmentation fix for the inline probe forwards on the big tier (see train.py).
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ALCF proxy for rank-0 wandb; keep loopback/cluster traffic (NCCL rendezvous
# on 127.0.0.1 for --standalone) off the proxy.
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY=$http_proxy HTTPS_PROXY=$https_proxy
export no_proxy=localhost,127.0.0.1,.alcf.anl.gov,.anl.gov
export NO_PROXY=$no_proxy

# HF dataset cache on eagle (pre-populated by the login-node snapshot_download).
# resolve_dataset_paths() reads configs/massivekb_xl.yaml's hf_repo and serves
# the train/ + val/ shards from $HF_HOME/hub. Pointing HF_HOME at eagle keeps
# the 49 GB off the home quota; HF_HUB_OFFLINE=1 skips the per-rank Hub
# revalidation and reads straight from disk — no network dependency for data.
export HF_HOME=/eagle/UIC-HPC/cgrams/hf
export HF_HUB_OFFLINE=1

export WANDB_DIR=$LOGDIR
export WANDB_RESUME=allow
export WANDB_RUN_ID=$RUN_NAME

# torchrun spawns one process per selected GPU; train.py reads RANK/WORLD_SIZE/LOCAL_RANK
# from the env and initialises the NCCL process group.
exec "$VENV/bin/torchrun" \
    --standalone --nnodes=1 --nproc_per_node=2 \
    -m msdelta.train \
    --config "$CFG" \
    --run-name "$RUN_NAME" \
    >"$LOGDIR/massivekb_xl.out" 2>"$LOGDIR/massivekb_xl.err"
