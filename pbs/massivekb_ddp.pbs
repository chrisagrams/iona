#!/bin/bash
#PBS -N mkb_ddp
#PBS -A FRAME-IDP
#PBS -q preemptable
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=12:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# Train the XL model on four A100 GPUs. Run setup_venv.sh before this job.

set -euo pipefail

REPO=/home/cgrams/msdelta
VENV=$REPO/.venv
CFG=$REPO/configs/massivekb_xl.yaml

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
RUN_NAME=massivekb_xl-polaris-gbs1024-${JOBID}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

cd "$REPO"
echo "$(date -Is) job=$PBS_JOBID host=$(hostname) gpus=$(nvidia-smi -L | wc -l) run=$RUN_NAME"
nvidia-smi -L | sed "s/^/  /"

# Limit the BLAS threads for each rank.
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# Permit CUDA to expand memory segments.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Use the proxy for external traffic only.
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY=$http_proxy HTTPS_PROXY=$https_proxy
export no_proxy=localhost,127.0.0.1,.alcf.anl.gov,.anl.gov
export NO_PROXY=$no_proxy

# Read the dataset from the shared cache.
export HF_HOME=/eagle/UIC-HPC/cgrams/hf
export HF_HUB_OFFLINE=1

export WANDB_DIR=$LOGDIR
export WANDB_RESUME=allow
export WANDB_RUN_ID=$RUN_NAME

# Start one process for each GPU.
exec "$VENV/bin/torchrun" \
    --standalone --nnodes=1 --nproc_per_node=4 \
    -m msdelta.train \
    --config "$CFG" \
    --run-name "$RUN_NAME" \
    >"$LOGDIR/massivekb_xl.out" 2>"$LOGDIR/massivekb_xl.err"
