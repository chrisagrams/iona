#!/bin/bash
#PBS -N contrastive_matrix
#PBS -A FRAME-IDP
#PBS -q capacity
#PBS -l select=4:system=polaris
#PBS -l place=scatter
#PBS -l walltime=12:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# 2x2 contrastive post-training matrix — one combo per Polaris node, each running
# 4-way DDP on that node's A100s. All four wandb runs land in project
# msdelta-contrastive (set in the configs).
#
#   node 0:  massivekb-pretrain  +  massivekb-contrastive   (mkb-pt_mkb-ct)
#   node 1:  massivekb-pretrain  +  consensus-contrastive   (mkb-pt_con-ct)
#   node 2:  consensus-pretrain  +  massivekb-contrastive   (con-pt_mkb-ct)
#   node 3:  consensus-pretrain  +  consensus-contrastive   (con-pt_con-ct)
#
# The pretrain corpus is the --pretrained-ckpt; the contrastive corpus is the
# --config (massivekb_xl_contrastive.yaml vs consensus_xl_28M_contrastive.yaml).
#
# Pretrained checkpoints:
#   massivekb = run v14_cap_XL_hf_7232144  (done)
#   consensus = run consensus_xl_28M_7235042  (INFLIGHT — final.pt not written yet)
#
# Because the consensus pretrain is still running, nodes 2 & 3 wait for its
# final.pt before starting (bounded by CON_WAIT_SECS). RECOMMENDED: submit with a
# dependency so the whole job only starts once the consensus pretrain finishes —
# then nothing waits and no node sits idle:
#   qsub -W depend=afterany:7235042 pbs/contrastive_matrix.pbs
#
# Layout: this script runs once on the head node (launcher branch), then re-execs
# itself once per node via `mpiexec --ppn 1` (node branch, guarded by --node).

set -euo pipefail

REPO=/home/cgrams/msdelta
VENV=$REPO/.venv
RUNS=/eagle/UIC-HPC/cgrams/msdelta-runs

# Pretrained encoders (override with `qsub -v MKB_PT=...,CON_PT=...`).
MKB_PT=${MKB_PT:-$RUNS/v14_cap_XL_hf_7232144/final.pt}
CON_PT=${CON_PT:-$RUNS/consensus_xl_28M_7235042/final.pt}

# How long nodes 2 & 3 will wait for the consensus final.pt to appear + settle.
CON_WAIT_SECS=${CON_WAIT_SECS:-28800}   # 8 h

# ---------------------------------------------------------------------------
# PER-NODE BRANCH — invoked by mpiexec, once per node. $PALS_RANKID = node index.
# ---------------------------------------------------------------------------
if [[ "${1:-}" == "--node" ]]; then
    RANK=${PALS_RANKID:-${PMI_RANK:-0}}
    JOBID=${MATRIX_JOBID:-local}

    case "$RANK" in
        0) CFG=massivekb_xl_contrastive.yaml;    PT=$MKB_PT; TAG=mkb-pt_mkb-ct ;;
        1) CFG=consensus_xl_28M_contrastive.yaml; PT=$MKB_PT; TAG=mkb-pt_con-ct ;;
        2) CFG=massivekb_xl_contrastive.yaml;    PT=$CON_PT; TAG=con-pt_mkb-ct ;;
        3) CFG=consensus_xl_28M_contrastive.yaml; PT=$CON_PT; TAG=con-pt_con-ct ;;
        *) echo "no combo for node rank $RANK" >&2; exit 0 ;;
    esac

    RUN_NAME=${TAG}_${JOBID}
    LOGDIR=$REPO/pbs/logs/${JOBID}/${TAG}
    mkdir -p "$LOGDIR"

    echo "$(date -Is) node=$RANK host=$(hostname) run=$RUN_NAME cfg=$CFG pt=$PT"

    # Wait for the pretrained checkpoint (the consensus one may still be inflight).
    # Require it to exist AND be size-stable for 60s so we never read a half-written
    # torch.save.
    waited=0
    while [[ ! -f "$PT" ]]; do
        if (( waited >= CON_WAIT_SECS )); then
            echo "node=$RANK ERROR: $PT never appeared after ${CON_WAIT_SECS}s" >&2
            exit 1
        fi
        echo "node=$RANK waiting for $PT ... (${waited}s)"; sleep 60; waited=$((waited+60))
    done
    prev_size=-1
    while :; do
        sz=$(stat -c %s "$PT")
        [[ "$sz" == "$prev_size" ]] && break
        prev_size=$sz; sleep 60
    done
    echo "$(date -Is) node=$RANK checkpoint ready ($PT, $(stat -c %s "$PT") bytes)"

    # Per-node env (mpiexec forwards the launcher env; set the per-combo bits here).
    export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
    export WANDB_DIR=$LOGDIR
    export WANDB_RESUME=allow
    export WANDB_RUN_ID=$RUN_NAME          # distinct id per combo → 4 separate runs

    # One torchrun per node → 4-way DDP on that node's 4 GPUs. --pretrained-ckpt
    # overrides the config's placeholder; --run-name distinguishes the 4 runs
    # (they share wandb_project: msdelta-contrastive from the config).
    exec "$VENV/bin/torchrun" \
        --standalone --nnodes=1 --nproc_per_node=4 \
        -m msdelta.train_contrastive \
        --config "$REPO/configs/$CFG" \
        --pretrained-ckpt "$PT" \
        --run-name "$RUN_NAME" \
        >"$LOGDIR/${TAG}.out" 2>"$LOGDIR/${TAG}.err"
fi

# ---------------------------------------------------------------------------
# LAUNCHER BRANCH — runs once on the head node, fans out one task per node.
# ---------------------------------------------------------------------------
JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

cd "$REPO"
NNODES=$(wc -l < "$PBS_NODEFILE")
echo "$(date -Is) job=$PBS_JOBID nodes=$NNODES matrix launch"
echo "  MKB_PT=$MKB_PT"
echo "  CON_PT=$CON_PT (inflight-safe: nodes 2&3 wait up to ${CON_WAIT_SECS}s)"
cat "$PBS_NODEFILE" | sed "s/^/  node: /"

if (( NNODES < 4 )); then
    echo "WARNING: only $NNODES node(s) allocated; need 4 for the full matrix." >&2
fi

# Shared env forwarded to every node (--envall). HF cache = inline probe only;
# proxy = rank-0 wandb; training data + checkpoints are local on eagle.
export MATRIX_JOBID=$JOBID
export MKB_PT CON_PT CON_WAIT_SECS
export HF_HOME=/eagle/UIC-HPC/cgrams/hf_cache
export HF_HUB_OFFLINE=1
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY=$http_proxy HTTPS_PROXY=$https_proxy
export no_proxy=localhost,127.0.0.1,.alcf.anl.gov,.anl.gov
export NO_PROXY=$no_proxy

# One launcher per node (--ppn 1). --cpu-bind none so each node's torchrun can use
# all cores for its 4 ranks + dataloader workers (default binding would pin the
# launcher — and thus all its children — to a single core).
exec mpiexec -n "$NNODES" --ppn 1 --cpu-bind none --envall \
    "$REPO/pbs/contrastive_matrix.pbs" --node
