#!/bin/bash -l
# Run several denoise fine-tune arms back to back inside one allocation.
#
#   qsub -q capacity -l select=6 -l walltime=06:00:00 pbs/aurora-finetune-sweep.pbs
#   qsub -q capacity -l select=3 -l walltime=06:00:00 -v ARMS_FILE=sweeps/subset.txt ...
#
# With no ARMS/ARMS_FILE it runs every arm under configs/sweep-denoise. At the default of
# one tile per arm a node carries twelve arms, so 72 arms need 6 nodes, not 72.
#
# Each arm gets TILES_PER_ARM tiles, so a host carries XPUS_PER_HOST/TILES_PER_ARM arms
# CONCURRENTLY, each pinned to a disjoint set of tiles with its own hostfile and its own
# rendezvous port. At the default of one tile per arm that is twelve arms per node, which
# turns ~22 serial node-hours into a single wave across 6 nodes.
#
# Arms are partitioned across nodes up front, balanced by an estimated cost read off the
# arm name (4 epochs doubles it, a 512-wide head adds ~30%). A work-stealing queue would
# pack tighter, but static assignment has no shared state between concurrently running
# nodes and therefore nothing to race on -- worth more here than the last few percent.
#
# An arm that fails does NOT abort the rest. A sweep exists to compare points, and losing
# eleven good arms because the twelfth diverged is the wrong trade; failures are counted
# and listed at the end instead.

#PBS -N msdelta-denoise-sweep
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
# Code from a commit (pbs/qsub_ref, MSDELTA_CODE_REF): take the snapshot FIRST, so the grid,
# the arms file and the staleness check below are the commit's, not the checkout's. A grid
# or arms file the commit does not have is read from the checkout path given (ad hoc).
# Without a ref the snapshot is taken further down, as before.
#
# RESUME_JOB=<job> continues that job, so by default it runs THAT job's configs and code:
#   configs  $SCRATCH_ROOT/runs/.configs-<job>, never SWEEP_ROOT as it is now (no grid
#            check either: those configs were checked when they were launched);
#   code     the commit in $SCRATCH_ROOT/code-snapshots/<job>/SNAPSHOT.txt, rebuilt with
#            git archive -- or, when that snapshot was taken from a DIRTY working tree (or
#            its commit is gone), that snapshot directory itself, reused as is.
# RESUME_CONFIGS=current / RESUME_CODE=current take what this job was submitted with
# instead (the old behaviour), e.g. for a job from before snapshots existed.
RESUME_CONFIGS_DIR=
if [[ -n ${RESUME_JOB:-} ]]; then
    SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/${PROJECT:-UIC-HPC}/$USER/msdelta}
    if [[ ${RESUME_CONFIGS:-original} != current ]]; then
        RESUME_CONFIGS_DIR=$SCRATCH_ROOT/runs/.configs-$RESUME_JOB
        [[ -d $RESUME_CONFIGS_DIR ]] || {
            echo "RESUME_JOB=$RESUME_JOB: its config snapshot $RESUME_CONFIGS_DIR is missing." >&2
            echo "  RESUME_CONFIGS=current resumes with SWEEP_ROOT as it is now instead." >&2
            exit 2; }
        echo "=== resume $RESUME_JOB: configs from $RESUME_CONFIGS_DIR"
    fi
    if [[ ${RESUME_CODE:-original} != current ]]; then
        _old=$SCRATCH_ROOT/code-snapshots/$RESUME_JOB
        [[ -f $_old/SNAPSHOT.txt ]] || {
            echo "RESUME_JOB=$RESUME_JOB: no code snapshot at $_old, so its code is unknown." >&2
            echo "  RESUME_CODE=current resumes with the code this job was submitted with." >&2
            exit 2; }
        _old_commit=$(sed -n 's/^commit: *//p' "$_old/SNAPSHOT.txt" | head -1)
        _old_name=$(sed -n 's/^branch: *//p' "$_old/SNAPSHOT.txt" | head -1)
        _old_dirty=
        if grep -q '^mode: *git-archive' "$_old/SNAPSHOT.txt"; then
            _old_dirty=
        elif grep -q '^dirty: *yes' "$_old/SNAPSHOT.txt" \
             || sed -n '/^uncommitted changes/,$p' "$_old/SNAPSHOT.txt" | tail -n +2 \
                | grep -q '[^[:space:]]'; then
            _old_dirty=1
        fi
        if [[ -n ${MSDELTA_CODE_REF:-} && $_old_commit != "$MSDELTA_CODE_REF"* ]]; then
            echo "RESUME_JOB=$RESUME_JOB ran $_old_commit, but this job was submitted with" >&2
            echo "  MSDELTA_CODE_REF=$MSDELTA_CODE_REF. RESUME_CODE=current to run that instead." >&2
            exit 2
        fi
        if [[ -z $_old_dirty && -n $_old_commit ]] \
           && git -C "$REPO_DIR" rev-parse --verify --quiet "${_old_commit}^{commit}" >/dev/null; then
            export MSDELTA_CODE_REF=$_old_commit MSDELTA_CODE_REF_NAME=${_old_name:-$_old_commit}
            echo "=== resume $RESUME_JOB: code from its commit ${_old_commit:0:12} (git archive)"
        else
            unset MSDELTA_CODE_REF
            export MSDELTA_CODE_REUSE=$_old
            if [[ -n $_old_dirty ]]; then
                echo "!!! resume $RESUME_JOB: its snapshot was taken from a DIRTY working tree" \
                     "(commit ${_old_commit:0:12} + uncommitted changes, see $_old/SNAPSHOT.txt);" \
                     "reusing that snapshot directory as is, not the commit" | tee /dev/stderr
            else
                echo "!!! resume $RESUME_JOB: commit ${_old_commit:-?} is not in $REPO_DIR;" \
                     "reusing its snapshot directory $_old as is" | tee /dev/stderr
            fi
        fi
        unset _old _old_commit _old_name _old_dirty
    fi
fi
if [[ -n ${MSDELTA_CODE_REF:-} || -n ${MSDELTA_CODE_REUSE:-} ]]; then
    SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/${PROJECT:-UIC-HPC}/$USER/msdelta}
    source "$REPO_DIR/pbs/lib/code_snapshot.sh"
fi
# ARMS as a comma-separated list only works for small sweeps: `qsub -v` rejects a long
# environment ("cannot send environment with the job"), and 72 arm names exceed it. So the
# default is every generated arm, and a subset goes through a file instead of the job
# environment.
# Which grid, and which entry point trains an arm. Defaulted to denoise because that is
# what this launcher was written for, but the partitioning, per-slot tile pinning,
# failure accounting and config snapshotting are task-independent and there is no reason
# to fork the file per objective.
SWEEP_ROOT=${SWEEP_ROOT:-configs/sweep-denoise}
SWEEP_MODULE=${SWEEP_MODULE:-msdelta.finetune_denoise}
# Where the grid is READ from: SWEEP_ROOT itself, or the commit's copy of it under a ref.
# SWEEP_ROOT stays the name (GRID_CHECK key, messages).
SWEEP_DIR=$SWEEP_ROOT
[[ -z ${MSDELTA_CODE_REF:-} ]] || SWEEP_DIR=$(msdelta_code_path "$SWEEP_ROOT")
[[ -z $RESUME_CONFIGS_DIR ]] || SWEEP_DIR=$RESUME_CONFIGS_DIR
ARMS=${ARMS:-}
if [[ -n ${ARMS_FILE:-} ]]; then
    [[ -z ${MSDELTA_CODE_REF:-} ]] || ARMS_FILE=$(msdelta_code_path "$ARMS_FILE")
    ARMS=$(tr -s ' \n' ',' < "$ARMS_FILE" | sed 's/,$//')
elif [[ -n $RESUME_CONFIGS_DIR && -z $ARMS ]]; then
    # every arm the original job had (its config snapshot also holds CODE_SNAPSHOT.txt)
    ARMS=$(find "$RESUME_CONFIGS_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' \
           | sort | paste -sd,)
elif [[ -z $ARMS ]]; then
    ARMS=$(ls "$SWEEP_DIR" | sort | paste -sd,)
fi
[[ -n $ARMS ]] || { echo "no arms: generate them with sweeps/make_denoise_grid.py" >&2; exit 2; }
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
PROJECT=${PROJECT:-UIC-HPC}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/$PROJECT/$USER/msdelta}
# Job-DAG reporting (pbs/dag/README.md): a notification file when the job ends, and the
# _SUCCESS.json manifest when every arm finished. No-op under DRY_RUN or outside PBS.
source "$REPO_DIR/pbs/lib/job_finish.sh"
XPUS_PER_HOST=${XPUS_PER_HOST:-12}
# TILES_PER_ARM=1 gives each arm a whole tile to itself and runs twelve arms per node
# instead of one. It is slower per arm (no data parallelism) but removes DDP entirely --
# no reducer, no gather, no unused-parameter detection -- which is where every
# correctness bug in this pipeline has come from. It also needs far fewer nodes: 72 arms
# fit on 6 nodes in one wave rather than 16 nodes in five.
#
# It is the DEFAULT because twelve-way DDP does not work: jobs 8840154 and 8840190 differ
# in nothing but rank count and DDP took a GPU page fault at step 168 while one tile ran
# 700 steps plus eval plus test clean.
#
# TILES_PER_ARM=12 IS safe -- and 21.4x faster -- when the arms carry
# `--deepspeed configs/deepspeed-zero2.json`, which replaces the DDP reducer entirely
# (job 8840264: twelve tiles, 300 steps plus eval plus test, zero faults). That is how the
# generated grid is built. Setting TILES_PER_ARM=12 with arms that do NOT name a deepspeed
# config puts you back on the reducer and back on the fault, so the two move together.
TILES_PER_ARM=${TILES_PER_ARM:-1}
# See aurora-finetune.pbs: everything before this prefix came out of a pipeline with known
# bugs and must not be compared against what comes after.
RUN_PREFIX=${RUN_PREFIX:-v2_}
SLOTS_PER_NODE=$(( XPUS_PER_HOST / TILES_PER_ARM ))
JOB_ID=${PBS_JOBID:-local}; JOB_ID=${JOB_ID%%.*}

IFS=',' read -r -a ARM_LIST <<< "$ARMS"
for arm in "${ARM_LIST[@]}"; do
    [[ -f $SWEEP_DIR/$arm/training.args ]] \
        || { echo "unknown arm: $arm" >&2; exit 2; }
done

# The arms are GENERATED from configs/finetune-denoise-50m/training.args, so every edit to
# that template silently invalidates them and nothing downstream notices. The grid sat at
# `max_peaks 1024` with no per_device_train_batch_size for a while after the template
# moved to 512 and a batch of 4 -- an 8x larger DeltaMZBias tensor, ~118 GB against a
# 68.7 GB tile. That is 72 arms OOMing on a 6-node allocation, discovered an hour in.
# Stdlib only, so this runs before the frameworks module is loaded.
#
# Every grid gets checked, not just the first one. The guard was written for
# configs/sweep-denoise and stayed pinned to it while five more grids appeared, each of
# which then had to be checked by hand -- which is precisely the habit this exists to
# replace. A grid with no entry here is REFUSED rather than waved through: silently
# skipping the check for an unrecognised path is how the pinned version stopped covering
# anything, and SKIP_GRID_CHECK is there for the deliberate exception.
declare -A GRID_CHECK=(
    [configs/sweep-conlong]="sweeps/make_conlong.py --check"
    [configs/sweep-confreeze]="sweeps/make_confreeze.py --check"
    [configs/sweep-con100k]="sweeps/make_con100k.py --check"
    [configs/sweep-con100k-best]="sweeps/make_c7_best.py --check"
    [configs/sweep-conhead]="sweeps/make_conhead.py --check"
    [configs/sweep-conhead-quick]="sweeps/make_conhead.py --quick --check"
    [configs/sweep-a3]="sweeps/make_a3.py --check"
    [configs/sweep-a4]="sweeps/make_a4.py --check"
    [configs/sweep-a6]="sweeps/make_a4.py --teacher 400m --check"
    [configs/sweep-a8]="sweeps/make_a8.py --check"
    [configs/sweep-c16-stage1]="sweeps/make_c16.py --stage 1 --check"
    [configs/sweep-c16-stage2]="sweeps/make_c16.py --stage 2 --check"
    [configs/sweep-conneg]="sweeps/make_conneg.py --check"
    [configs/sweep-conbig]="sweeps/make_conbig.py"
    [configs/sweep-conhp-eval]="sweeps/make_conhp_eval.py"
    [configs/sweep-conpk]="sweeps/make_conpk.py"
    [configs/sweep-gradcache-confirm]="sweeps/make_gradcache_confirm.py"
    [configs/sweep-conhp-edge]="sweeps/make_conhp_edge.py"
    [configs/sweep-conhp-seeds]="sweeps/make_conhp_seeds.py"
    [configs/sweep-denoise]="sweeps/make_denoise_grid.py --check"
    [configs/sweep-denoise-100m]="sweeps/make_denoise_size_grid.py --size 100m --check"
    [configs/sweep-denoise-200m]="sweeps/make_denoise_size_grid.py --size 200m --check"
    [configs/sweep-denoise-400m]="sweeps/make_denoise_size_grid.py --size 400m --check"
    [configs/sweep-denoise400m-probe]="sweeps/make_denoise400m_probe.py --check"
    [configs/sweep-denoise-scratch]="sweeps/make_scratch_grid.py --check"
    [configs/sweep-denoise-seeds]="sweeps/make_seed_grid.py --sizes 50m,100m,200m,400m --seeds 6 --check"
    [configs/sweep-layermix]="sweeps/make_layermix_grid.py --check"
    [configs/sweep-layermix-random]="sweeps/make_layermix_grid.py --random --check"
    [configs/sweep-startpoint]="sweeps/make_startpoint_grid.py --check"
    [configs/sweep-repeat]="sweeps/make_repeat_grid.py --check"
    [configs/sweep-seedvar]="sweeps/make_seedvar_grid.py --check"
    [configs/sweep-contrastive-scale]="sweeps/make_contrastive_scale_grid.py --check"
    [configs/sweep-pairloss]="sweeps/make_pairloss_grid.py --check"
    # A hand-picked subset of sweep-contrastive-scale arms, re-run with
    # MSDELTA_SDPA_MATH=1 to test whether the fused SDPA kernel is the
    # source of the 0xff00.... scratch fault. Copied, not generated, so it
    # is verified against the grid it came from rather than a generator.
    [configs/sweep-conscale-retry]="sweeps/verify_subset.py configs/sweep-conscale-retry configs/sweep-contrastive-scale"
    [configs/sweep-conscale-big]="sweeps/verify_subset.py configs/sweep-conscale-big configs/sweep-contrastive-scale"
    [configs/sweep-contrastive]="sweeps/make_contrastive_grid.py --check"
    [configs/sweep-contrastive-random]="sweeps/make_contrastive_grid.py --random --check"
    [configs/sweep-random-budget]="sweeps/make_random_budget_grid.py --check"
    [configs/sweep-contrastive-epochs-v2]="sweeps/make_contrastive_epochs_grid.py --check"
    # FT13: the pretrained winner at the scratch grid's 8 epochs, so "+0.032 at
    # double budget" can be attributed to pretraining rather than to the budget.
    [configs/sweep-denoise-seeds-ep8]="sweeps/make_seed_grid.py --sizes 50m --seeds 6 --epochs 8 --check"
    # The rest of the 8-epoch row. Separate directory from the 50m one because a
    # QUEUED job globs its grid at job start, so extending that directory would
    # have changed what 8846027 runs after it was already submitted.
    [configs/sweep-denoise-seeds-ep8-mid]="sweeps/make_seed_grid.py --sizes 100m,200m --seeds 6 --epochs 8 --out-name sweep-denoise-seeds-ep8-mid --check"
    # The pretraining ablation at 100m/200m/400m, plus 50m at 16 epochs.
    [configs/sweep-denoise-scratch-scale]="sweeps/make_scratch_scale_grid.py --check"
    # Does the contrastive HP choice transfer across scale? 50m re-run alongside
    # 100m because the existing 50m grid predates the FT14 fix and is n=1.
    [configs/sweep-contrastive-hp]="sweeps/make_contrastive_hp_grid.py --check"
    # FT17: the first pair grid won at its corner, so margin extends through
    # 1.414 (orthogonal) and lr through 5e-4.
    [configs/sweep-pairloss-hp]="sweeps/make_pairloss_hp_grid.py --check"
    # The corrected-HP re-take of the scale curve, and the three follow-ups the
    # HP grid unblocked: breadth for PK, breadth for pairs, HP at 200m/400m.
    [configs/sweep-contrastive-scale-v2]="sweeps/make_contrastive_scale_v2.py --check"
    # The pretraining ablation for contrastive, matched to the curve above.
    [configs/sweep-contrastive-scale-v2-random]="sweeps/make_contrastive_random_v2.py --check"
    # The pretraining-checkpoint ladder, middle two rungs first.
    [configs/sweep-ckpt-denoise]="sweeps/make_checkpoint_grid.py --task denoise --check"
    [configs/sweep-ckpt-denoise-ends]="sweeps/make_checkpoint_grid.py --task denoise --wave ends --scales 50m 100m --check"
    [configs/sweep-ckpt-denoise-ends-big]="sweeps/make_checkpoint_grid.py --task denoise --wave ends-big --scales 200m 400m --check"
    [configs/sweep-ckpt-denoise-late400]="sweeps/make_checkpoint_grid.py --task denoise --wave late400 --scales 400m --check"
    [configs/sweep-ckpt-contrastive]="sweeps/make_checkpoint_grid.py --task contrastive --check"
    # Does the HP optimum move with pretraining? Asked once, at 50m, between
    # the 25%-trained checkpoint the config came from and the 100% one.
    [configs/sweep-ckpthp-denoise]="sweeps/make_ckpt_hp_grid.py --task denoise --check"
    [configs/sweep-ckpthp-contrastive]="sweeps/make_ckpt_hp_grid.py --task contrastive --check"
    [configs/sweep-pairaccum]="sweeps/make_pairaccum_grid.py --check"
    [configs/sweep-gradcache-v2]="sweeps/make_gradcache_v2_grid.py --check"
    [configs/sweep-contrastive-hp-big]="sweeps/make_contrastive_hp_big.py --check"
    # Single-dataset contrastive recipe: C8 x C19, its per-scale HP search, and the
    # mixed same-mass / random batch ablation.
    [configs/sweep-c8c19]="sweeps/make_c8c19.py --check"
    [configs/sweep-hp-single]="sweeps/make_hp_single.py --check"
    [configs/sweep-mix]="sweeps/make_mix.py --check"
    [configs/sweep-regions]="sweeps/make_regions.py --check"
    [configs/sweep-hp50b]="sweeps/make_hp50b.py --check"
    [configs/sweep-c20]="sweeps/make_c20.py --check"
    [configs/sweep-hp-scale]="sweeps/make_hp_scale.py --check"
)
if [[ -n $RESUME_CONFIGS_DIR ]]; then
    echo "  grid check skipped: resuming with $RESUME_JOB's own configs, checked at its launch"
elif [[ -z ${SKIP_GRID_CHECK:-} ]]; then
    check=${GRID_CHECK[${SWEEP_ROOT%/}]:-}
    if [[ -z $check ]]; then
        echo "no staleness check registered for $SWEEP_ROOT." >&2
        echo "  Add its generator to GRID_CHECK in this script, or set SKIP_GRID_CHECK=1" >&2
        echo "  to accept arms that nothing has verified against their template." >&2
        exit 2
    fi
    if [[ -z ${MSDELTA_CODE_REF:-} ]]; then
        "$VENV_DIR/bin/python" $check \
            || { echo "sweep arms are stale against their template" >&2; exit 2; }
    else
        # The commit's generator against the commit's grid and templates: run it inside the
        # snapshot (generators find configs/ relative to their own file, verify_subset.py
        # relative to the cwd). A grid the commit does not have cannot be checked there.
        [[ $SWEEP_DIR == "$MSDELTA_CODE_DIR/"* ]] || {
            echo "$SWEEP_ROOT is not committed at $MSDELTA_CODE_REF: its check cannot run" >&2
            echo "  against the commit. Commit the grid on that branch, or SKIP_GRID_CHECK=1." >&2
            exit 2; }
        ( cd "$MSDELTA_CODE_DIR" && "$VENV_DIR/bin/python" $check ) \
            || { echo "sweep arms are stale against their template (at $MSDELTA_CODE_REF)" >&2; exit 2; }
    fi
fi

# Multiple tiles per arm without DeepSpeed means the DDP reducer, which faults (FT7).
if (( TILES_PER_ARM > 1 )) \
   && ! grep -q -- "--deepspeed" "$SWEEP_DIR/${ARM_LIST[0]}/training.args"; then
    echo "TILES_PER_ARM=$TILES_PER_ARM but the arms name no --deepspeed config:" >&2
    echo "  that is the DDP reducer, which takes a GPU page fault. See notes/TODO.md FT7." >&2
    exit 2
fi

# And the inverse, which is the easier mistake to make because TILES_PER_ARM defaults
# to 1 and omitting it looks like omitting nothing.
#
# A DeepSpeed arm on ONE tile is not a slower version of the same experiment, it is a
# DIFFERENT one: per_device_train_batch_size 1 across 12 tiles is an effective batch of
# 12, and across 1 tile it is an effective batch of 1. Job 8846027 ran the whole FT13
# grid that way -- six arms, six hours, 43,400 steps each -- and every number it would
# have produced was incomparable with the batch-12 runs it existed to be compared
# against. It surfaced only because the resume then failed: DeepSpeed refuses to load a
# ZeRO checkpoint written at DP world size 1 into a world of 12.
#
# Override with ONE_TILE_OK=1 if a single-tile DeepSpeed run is genuinely wanted.
if (( TILES_PER_ARM == 1 )) && [[ -z ${ONE_TILE_OK:-} ]] \
   && grep -q -- "--deepspeed" "$SWEEP_DIR/${ARM_LIST[0]}/training.args"; then
    echo "TILES_PER_ARM is 1 but the arms name a --deepspeed config." >&2
    echo "  That changes the EFFECTIVE BATCH, not just the speed: per_device 1 on one" >&2
    echo "  tile is batch 1, where every other denoise run is batch 12. Pass" >&2
    echo "  TILES_PER_ARM=12, or ONE_TILE_OK=1 if you mean it." >&2
    exit 2
fi

# Snapshot the arm configs. run_node reads an arm's training.args at the moment it
# launches that arm, which can be hours into the job, so editing or regenerating the grid
# on the login node while a sweep runs silently changes what the later arms train -- or
# hands one a half-written file. Copying once, up front, makes a job immutable after
# submission and makes its configs recoverable afterwards from the run directory.
CONFIG_SNAPSHOT=$SCRATCH_ROOT/runs/.configs-$JOB_ID
mkdir -p "$CONFIG_SNAPSHOT"
cp -r "$SWEEP_DIR/." "$CONFIG_SNAPSHOT/"
# training.args name other files by repo-relative path (configs/deepspeed-zero2.json), which
# the trainer resolves against the cwd -- the checkout. Under a ref, say so when the
# checkout's copy differs from the commit's.
if [[ -n ${MSDELTA_CODE_REF:-} ]]; then
    for _f in $(grep -ohE '(^|[[:space:]])configs/[^[:space:]]+' "$CONFIG_SNAPSHOT"/*/training.args \
                | sort -u); do
        [[ -f $MSDELTA_CODE_DIR/$_f ]] || continue
        cmp -s "$MSDELTA_CODE_DIR/$_f" "$REPO_DIR/$_f" \
            || echo "WARNING: $_f (named in training.args, read from the checkout) differs from ${MSDELTA_CODE_REF:0:12}'s" >&2
    done
fi
[[ -n ${DRY_RUN:-} ]] || echo "  configs snapshot: $CONFIG_SNAPSHOT"

mapfile -t HOSTS < <(sort -u "${PBS_NODEFILE:?PBS_NODEFILE is required}")
# One "node" in the scheduling below is really one SLOT: a host contributes
# SLOTS_PER_NODE of them, each owning a disjoint set of tiles.
NODES=()
SLOT_TILES=()
# TILE_STRIDE spreads slots across PHYSICAL CARDS rather than packing tiles: a node has
# 12 tiles but only 6 Intel Max 1550 cards, two tiles each. TILE_STRIDE=2 uses tiles
# 0,2,4,6,8,10 -- six arms, one per card, no sibling -- at half the arms per node.
#
# THIS KNOB DOES NOT FIX THE 0xff00.... GPU FAULT, whatever an earlier version of this
# comment claimed. It was added on the theory that a card's two tiles each report
# 68.7 GB against a shared physical 128 GB, so a sibling pair over-subscribes the card
# and one of them faults. That theory was tested and is FALSE:
#
#   same-card pairs        clean, 38.75 GB reserved on each tile
#   1 / 2 / 4 / 8 / 12 arms per node   all clean at 38.73 GB
#   TILE_STRIDE=2 rerun    faulted anyway
#
# The real cause was in the collator, not the hardware: AlignmentCollator padded each
# batch to the longest spectrum IN THAT BATCH, and DeltaMZBias is O(batch * width^2), so
# memory depended on which spectra the sampler happened to draw together -- 38.75 GB at
# seed 0 and 67.14 GB at seed 3 for one identical config. Every interactive test used
# the default seed 0, the one value that hides it. Fixed by padding to max_peaks; see
# msdelta/reranking.py and TODO FT7/FT12. Verified in job 8845623: 12/12 arms, 0 faults,
# 29.64 GB at every 200m seed and 37.28 GB at every 400m seed.
#
# So reach for TILE_STRIDE only to give one arm more of a card's bandwidth, never as a
# remedy for a fault. A fault now means something new, and pinning it on sibling tiles
# would be repeating a refuted diagnosis.
TILE_STRIDE=${TILE_STRIDE:-1}
if (( TILE_STRIDE > 1 )); then
    SLOTS_PER_NODE=$(( XPUS_PER_HOST / (TILES_PER_ARM * TILE_STRIDE) ))
    (( SLOTS_PER_NODE > 0 )) || { echo "TILE_STRIDE=$TILE_STRIDE leaves no slots" >&2; exit 2; }
    echo "  TILE_STRIDE=$TILE_STRIDE: $SLOTS_PER_NODE arms per node, one per card"
fi
for host in "${HOSTS[@]}"; do
    for (( slot = 0; slot < SLOTS_PER_NODE; slot++ )); do
        NODES+=("$host")
        first=$(( slot * TILES_PER_ARM * TILE_STRIDE ))
        SLOT_TILES+=("$(seq -s, "$first" "$TILE_STRIDE" $(( first + (TILES_PER_ARM - 1) * TILE_STRIDE )))")
    done
done
NUM_NODES=${#NODES[@]}

if [[ -z ${DRY_RUN:-} ]]; then
set +u
source /usr/share/lmod/lmod/init/bash
source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/lib/load_frameworks.sh"
set -u
fi

export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
# Job-wide default; a one-tile-per-arm run overrides it per slot inside run_node.
export ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-$(seq -s, 0 $((XPUS_PER_HOST - 1)))}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-4}
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_KVS_MODE=mpi
export FI_MR_CACHE_MONITOR=${FI_MR_CACHE_MONITOR:-userfaultfd}
# Recommended by the ALCF Aurora known-issues page for jobs at scale. They tune the
# CXI completion queues and overflow buffers, which are undersized by default for
# many-rank jobs, and TMPDIR keeps scratch off a shared filesystem.
export FI_CXI_DEFAULT_CQ_SIZE=${FI_CXI_DEFAULT_CQ_SIZE:-131072}
export FI_CXI_OFLOW_BUF_SIZE=${FI_CXI_OFLOW_BUF_SIZE:-8388608}
export FI_CXI_CQ_FILL_PERCENT=${FI_CXI_CQ_FILL_PERCENT:-20}
export ZES_ENABLE_SYSMAN=${ZES_ENABLE_SYSMAN:-1}
export TMPDIR=${TMPDIR:-/tmp}
# Diagnostic: force SDPA onto the unfused MATH backend. See reranking.py.
export MSDELTA_SDPA_MATH=${MSDELTA_SDPA_MATH:-}
# See aurora-finetune.pbs: required once the reducer holds the full encoder.
unset CCL_ZE_IPC
unset CCL_ZE_IPC_EXCHANGE
export MASTER_ADDR=${MASTER_ADDR:-$(head -n 1 "$PBS_NODEFILE")}
export MASTER_PORT=${MASTER_PORT:-29500}
export MSDELTA_XPUS_PER_HOST=$XPUS_PER_HOST
# One node per arm, so the world is always a single node regardless of allocation size.
export MSDELTA_WORLD_SIZE=$XPUS_PER_HOST
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Run from a frozen copy of the code (pbs/lib/code_snapshot.sh): branch switches and
# edits in the checkout cannot affect this job once it has started.
source "$REPO_DIR/pbs/lib/code_snapshot.sh"
# Record the code each arm ran (SNAPSHOT.txt: commit, branch or ref, mode) with its outputs.
[[ -f $MSDELTA_CODE_DIR/SNAPSHOT.txt ]] && cp "$MSDELTA_CODE_DIR/SNAPSHOT.txt" "$CONFIG_SNAPSHOT/CODE_SNAPSHOT.txt"
# Probes: dtype, index-range and finiteness checks, and -- the useful part --
# a device synchronise at each stage, so an asynchronous GPU fault is reported
# where it was caused rather than dozens of steps later. Set MSDELTA_PROBES=1 on
# debug runs. Leave it unset for real training: the synchronises serialise the
# queue and cost throughput.
export MSDELTA_PROBES=${MSDELTA_PROBES:-}
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}

ALCF_PROXY=${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTP_PROXY=${HTTP_PROXY:-$ALCF_PROXY} HTTPS_PROXY=${HTTPS_PROXY:-$ALCF_PROXY}
export http_proxy=${http_proxy:-$ALCF_PROXY} https_proxy=${https_proxy:-$ALCF_PROXY}
export ftp_proxy=${ftp_proxy:-$ALCF_PROXY}
export no_proxy=${no_proxy:-admin,localhost,*.cm.aurora.alcf.anl.gov,aurora-*,*.aurora.alcf.anl.gov,*.alcf.anl.gov},127.0.0.1
export NO_PROXY="$no_proxy"

if [[ -z ${DRY_RUN:-} ]]; then
source "$REPO_DIR/pbs/load_keys.sh"
[[ -n ${WANDB_API_KEY:-} ]] || { echo "WANDB_API_KEY not loaded" >&2; exit 2; }
wandb_code=$(curl --silent --max-time 30 -o /dev/null -w '%{http_code}' https://api.wandb.ai || echo 000)
[[ $wandb_code != 000 ]] || { echo "no outbound route to api.wandb.ai" >&2; exit 2; }
"$VENV_DIR/bin/python" -c "
import torch, sys
n = torch.xpu.device_count()
print(f'  torch={torch.__version__} xpus={n} xccl={torch.distributed.is_xccl_available()}')
# Guard with an if rather than sys.exit(cond and msg): sys.exit('') returns status 1,
# because Python treats any string as an error message. That silently killed job 8839920
# right after this line printed, with no message to say why.
if n != $XPUS_PER_HOST:
    sys.exit(f'  visible tiles {n} != $XPUS_PER_HOST')
" || exit 2
fi

echo "=== sweep [$SWEEP_MODULE]: ${#ARM_LIST[@]} arms, ${#HOSTS[@]} hosts x $SLOTS_PER_NODE slots"\
     "= $NUM_NODES concurrent, $TILES_PER_ARM tile(s) each, job $JOB_ID ==="

# Longest-processing-time-first onto the emptiest node: the standard greedy makespan
# heuristic, and it matters because a 4-epoch 512-wide arm costs ~3x a baseline one, so
# naive round-robin would leave one node running long after the others idle.
declare -A NODE_ARMS NODE_COST
for i in "${!NODES[@]}"; do NODE_ARMS[$i]=""; NODE_COST[$i]=0; done
weighted=()
for arm in "${ARM_LIST[@]}"; do
    cost=10
    [[ $arm == *_ep4_* ]] && cost=$(( cost * 2 ))
    [[ $arm == *_h512  ]] && cost=$(( cost * 13 / 10 ))
    [[ $arm == *_h256  ]] && cost=$(( cost * 11 / 10 ))
    weighted+=("$cost $arm")
done
while read -r cost arm; do
    best=0
    for i in "${!NODES[@]}"; do
        (( NODE_COST[$i] < NODE_COST[$best] )) && best=$i
    done
    NODE_ARMS[$best]="${NODE_ARMS[$best]} $arm"
    NODE_COST[$best]=$(( NODE_COST[$best] + cost ))
done < <(printf '%s\n' "${weighted[@]}" | sort -rn)

for i in "${!NODES[@]}"; do
    echo "  slot $i ${NODES[$i]} tiles=${SLOT_TILES[$i]} cost=${NODE_COST[$i]} :${NODE_ARMS[$i]}"
done

# DRY_RUN stops after the partition so the balance can be checked on a login node with a
# fabricated PBS_NODEFILE. Everything above this point -- arm validation, node parsing,
# the greedy assignment -- is the part most likely to be wrong, and none of it needs a GPU.
if [[ -n ${DRY_RUN:-} ]]; then
    echo "  (dry run: stopping before launch)"
    exit 0
fi

run_node() {
    local index=$1 node=${NODES[$1]} arm status took start node_failed=0
    local hostfile=$SCRATCH_ROOT/runs/.hostfile-$JOB_ID-$index
    echo "$node" > "$hostfile"
    # Each node is its own single-rank-group world: MASTER_ADDR is that node, so the
    # shared MASTER_PORT cannot collide across concurrent arms.
    for arm in ${NODE_ARMS[$index]}; do
        local dir=$SCRATCH_ROOT/runs/sweep-$arm-$JOB_ID
        local resume=() ckpt=""
        # RECOVERY. An arm killed at walltime used to be lost outright even though it had
        # been writing checkpoints the whole time: a fresh job mints a new
        # sweep-$arm-$JOB_ID directory and never looks at the old one. The 400m arms at 8
        # epochs finish ~15 minutes inside an 8 hour walltime, so this is a live risk and
        # not a hypothetical -- losing one discards nearly eight hours of training that is
        # already 91% done and sitting on disk.
        #
        # RESUME_JOB=<jobid> reuses that job's per-arm directories: arms that already
        # produced test_results.json are SKIPPED, and any arm with a checkpoint restarts
        # from the newest one. Re-submitting the same grid with RESUME_JOB set therefore
        # finishes exactly what is missing and repeats nothing.
        if [[ -n ${RESUME_JOB:-} ]]; then
            dir=$SCRATCH_ROOT/runs/sweep-$arm-$RESUME_JOB
            # Denoise signals completion with test_results.json. Contrastive never
            # writes one -- it writes final/ and retrieval_results.json -- so testing
            # only the first re-ran every FINISHED contrastive arm on resume.
            if [[ -f $dir/test_results.json ]] \
               || [[ -d $dir/final && -f $dir/retrieval_results.json ]] \
               || [[ -d $dir/final && -f $dir/crossmodal_results.json ]]; then
                echo "  [skip $arm] already complete in $RESUME_JOB"
                continue
            fi
            # Sort by the numeric step, not lexically: checkpoint-9000 must not outrank
            # checkpoint-29072.
            # And take the newest COMPLETE one. A job killed mid-save leaves a newest
            # checkpoint with no trainer_state.json (written near the end of a save);
            # resuming from it failed all five arms of 8856525 within 65 s.
            ckpt=""
            for step in $(ls -d "$dir"/checkpoint-* 2>/dev/null \
                          | sed 's/.*checkpoint-//' | sort -rn); do
                if [[ -f $dir/checkpoint-$step/trainer_state.json ]]; then
                    ckpt=$step; break
                fi
                echo "  [skip checkpoint-$step of $arm] incomplete: no trainer_state.json"
            done
            if [[ -n $ckpt ]]; then
                resume=(--resume_from_checkpoint "$dir/checkpoint-$ckpt")
                echo "  [resume $arm] from step $ckpt in $RESUME_JOB"
            else
                echo "  [restart $arm] no checkpoint in $RESUME_JOB, starting over"
            fi
        fi
        mkdir -p "$dir/logs"
        # per job, so a resumed arm keeps the record of every job that trained it
        [[ -f $MSDELTA_CODE_DIR/SNAPSHOT.txt ]] && cp "$MSDELTA_CODE_DIR/SNAPSHOT.txt" "$dir/CODE_SNAPSHOT-$JOB_ID.txt"
        start=$SECONDS
        # Each slot pins its own tiles and its own port, so concurrent arms on one host
        # never share a device or a rendezvous.
        MASTER_ADDR=$node MASTER_PORT=$(( 29500 + index )) \
        ZE_AFFINITY_MASK=${SLOT_TILES[$index]} \
        MSDELTA_XPUS_PER_HOST=$TILES_PER_ARM MSDELTA_WORLD_SIZE=$TILES_PER_ARM \
        WANDB_DIR=$dir/logs WANDB_RESUME=allow \
        WANDB_RUN_ID=$RUN_PREFIX$arm-$JOB_ID \
        mpiexec --envall --pmi=pmix -n "$TILES_PER_ARM" --ppn "$TILES_PER_ARM" \
            --cpu-bind depth --depth "${CPU_DEPTH:-8}" --hostfile="$hostfile" \
            "$MSDELTA_CODE_DIR/pbs/rank_wrapper.sh" \
            "$VENV_DIR/bin/python" -m "$SWEEP_MODULE" \
                --args_file "$CONFIG_SNAPSHOT/$arm/training.args" \
                --output_dir "$dir" "${SHORT[@]}" "${resume[@]}" \
            >"$dir/logs/train.log" 2>&1
        # No `|| true` here: the script runs under `set -uo pipefail`, not `set -e`, so a
        # non-zero mpiexec does not abort the function -- and `|| true` would force
        # status to 0 and silently defeat the failure detection below.
        status=$?
        took=$(( SECONDS - start ))
        # One arm failing must not take the node or the sweep down; a grid exists to
        # compare points and losing the rest to one divergent arm is the wrong trade.
        if [[ $status -eq 0 ]]; then
            echo "  [ok   $arm] ${took}s on $node"
            grep -oE "\[denoise\] test: \{[^}]*\}" "$dir/logs/train.log" | tail -1 | sed "s/^/      /"
        else
            echo "  [FAIL $arm] exit $status after ${took}s on $node -- $dir/logs/train.log"
            echo "$arm" >> "$SCRATCH_ROOT/runs/.failed-$JOB_ID"
            node_failed=1
        fi
    done
    # Explicit: a function inherits the status of its last command, and that was the
    # `grep ... | tail | sed` printing an arm's test metrics. Under MAX_STEPS the test
    # evaluation is disabled, so grep matches nothing, returns 1, pipefail propagates it,
    # and both healthy nodes were reported as dead subshells in job 8839957.
    return $node_failed
}

# MAX_STEPS turns the sweep into a mechanics test: the point is to prove the partitioning,
# the per-node hostfiles and the concurrent mpiexec launches work, which needs a few steps
# per arm rather than a full fine-tune.
# Two ways to shorten a run, and they are not equivalent.
#
# MAX_SAMPLES caps the number of ROWS and changes nothing else, so the arm runs its real
# epochs to completion and every end-of-training path actually executes: periodic
# evaluation, checkpoint writes under ZeRO-2 sharding, save_total_limit rotation,
# load_best_model_at_end, the test split, the final save. THIS is what a pre-capacity
# smoke test should use. A failure in any of those is otherwise discovered hours into a
# real sweep -- and two alignment bugs (8840257, 8840277) did exactly that, training
# hundreds of steps before dying in evaluation, because parts of that path exist nowhere
# else: torch takes a fused transformer kernel only when grad is disabled, and
# metric_for_best_model is only read after an eval.
#
# MAX_STEPS caps steps instead, which stops training before any of that machinery runs.
# It is for measuring throughput, not for proving correctness.
SHORT=()
if [[ -n ${MAX_SAMPLES:-} ]]; then
    SHORT=(--max_samples "$MAX_SAMPLES" --eval_steps "${SMOKE_EVAL_STEPS:-10}"
           --save_steps "${SMOKE_EVAL_STEPS:-10}" --logging_steps 5)
elif [[ -n ${MAX_STEPS:-} ]]; then
    SHORT=(--max_steps "$MAX_STEPS" --save_strategy no
           --load_best_model_at_end false
           --eval_strategy steps --eval_steps "$MAX_STEPS")
fi

rm -f "$SCRATCH_ROOT/runs/.failed-$JOB_ID"
declare -A NODE_PID
for i in "${!NODES[@]}"; do run_node "$i" & NODE_PID[$i]=$!; done

# Wait per-PID rather than bare `wait`, so a node subshell that dies before it can write
# anything is still counted. Job 8839937 reported "4/4 arms ok" having run none, because
# the tally came only from a file the dead subshell never created.
node_failures=0
for i in "${!NODES[@]}"; do
    if ! wait "${NODE_PID[$i]}"; then
        echo "  [node ${NODES[$i]}] subshell exited non-zero -- its arms did not all run"
        node_failures=$(( node_failures + 1 ))
    fi
done

# Count arms that FINISHED, in the dirs they actually wrote to. A RESUME_JOB round
# writes into the original job's dirs, so counting dirs named after this job reported
# "0/3 ok, 3 never started" and exit 1 for a resume whose three arms all finished
# (8846565). Existence of a dir is not completion either: denoise marks it with
# test_results.json, contrastive with final/ plus retrieval_results.json.
out_job=${RESUME_JOB:-$JOB_ID}
completed=0
for arm in "${ARM_LIST[@]}"; do
    d=$SCRATCH_ROOT/runs/sweep-$arm-$out_job
    # Alignment (finetune_align) marks completion with final/ plus crossmodal_results.json.
    if [[ -f $d/test_results.json || ( -d $d/final && -f $d/retrieval_results.json ) \
          || ( -d $d/final && -f $d/crossmodal_results.json ) ]]; then
        completed=$(( completed + 1 ))
    fi
done
# `$(wc -l < missing 2>/dev/null || echo 0)` still prints a shell-level redirect error,
# because the 2>/dev/null applies to wc and not to the redirect the shell performs first.
failed_file=$SCRATCH_ROOT/runs/.failed-$JOB_ID
failed_count=0
[[ -f $failed_file ]] && failed_count=$(wc -l < "$failed_file")
ok=$completed
JF_ARMS_OK=$ok JF_ARMS_TOTAL=${#ARM_LIST[@]}
JF_SUMMARY="$ok/${#ARM_LIST[@]} arms ok ($failed_count failed, $node_failures node subshells died)"
for arm in "${ARM_LIST[@]}"; do jf_output "$SCRATCH_ROOT/runs/sweep-$arm-$out_job"; done
echo; echo "=== done: $ok/${#ARM_LIST[@]} arms ok "\
     "($failed_count failed, $(( ${#ARM_LIST[@]} - completed - failed_count )) unfinished, "\
     "$node_failures node subshells died) ==="
[[ $failed_count -gt 0 ]] && sed 's/^/  failed: /' "$failed_file"
# A sweep that ran nothing must not look like a success to whatever reads the exit code.
[[ $ok -eq ${#ARM_LIST[@]} ]] || exit 1
rm -f "$SCRATCH_ROOT/runs/.hostfile-$JOB_ID-"*
exit 0
