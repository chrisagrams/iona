#!/bin/bash
#PBS -N msdelta_v13_az
#PBS -A FRAME-IDP
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# v13 post-sweep analysis — short debug-queue job. For each of the four
# finished KL × mask-ratio runs, pin one GPU and run:
#   1. msdelta-analyze --mode both  → Δm bias alignment (b) + functional
#      probe (c): peak→chemistry-mass matching and attention-vs-bias
#      Spearman per head. Writes alignment.json + plots into the run dir.
#   2. msdelta-retrieval --check-overlap → embedding retrieval P/R against
#      the consensus val parquet, vs binned-cosine baseline.
#
# analyze/retrieval read data.root + the val split from the checkpoint's
# stored cfg (already the eagle path), so no config splice is needed.
# Neither hits the network → no ALCF proxy env required.
#
# Both tools are quick (analyze probe = 20 val batches; retrieval caps at
# max-peptides×per-peptide spectra), so 4-way GPU fan-out finishes well
# inside the 30-min debug walltime.
#
# Override the sweep job id if re-pointing at a different run set:
#   qsub -v RUNS_JOBID=7173699 pbs/v13_analyze.pbs

set -euo pipefail

REPO=/home/cgrams/msdelta
VENV=$REPO/.venv
RUNROOT=/eagle/UIC-HPC/cgrams/msdelta-runs
RUNS_JOBID=${RUNS_JOBID:-7173699}
cd "$REPO"

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

echo "$(date -Is) job=$PBS_JOBID host=$(hostname) analyzing v13 runs from job ${RUNS_JOBID}"
nvidia-smi -L | sed "s/^/  /"

export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4

# One mask tier per GPU: analyze (both) then retrieval, logged per tier.
analyze_one() {
    local tag=$1 gpu=$2
    local run="${RUNROOT}/v13_${tag}_${RUNS_JOBID}"
    local ckpt="${run}/final.pt"
    local out="${LOGDIR}/${tag}.out"

    {
        echo "[$(date -Is)] tag=${tag} gpu=${gpu} ckpt=${ckpt}"
        if [[ ! -f "$ckpt" ]]; then
            echo "MISSING checkpoint: $ckpt" >&2
            exit 1
        fi
        export CUDA_VISIBLE_DEVICES=$gpu

        echo "=== msdelta-analyze --mode both (${tag}) ==="
        "$VENV/bin/msdelta-analyze" \
            --ckpt "$ckpt" --mode both --plot \
            --out "${run}/alignment.json" --device cuda

        echo "=== msdelta-retrieval --check-overlap (${tag}) ==="
        "$VENV/bin/msdelta-retrieval" \
            --ckpt "$ckpt" --check-overlap --device cuda

        echo "[$(date -Is)] tag=${tag} done"
    } >"$out" 2>&1
}

PIDS=()
i=0
for tag in mask15 mask35 mask50 mask75; do
    analyze_one "$tag" "$i" &
    PIDS+=($!)
    echo "$(date -Is) launched ${tag} gpu=${i} pid=$!"
    i=$((i + 1))
done

set +e
FAIL=0
i=0
for tag in mask15 mask35 mask50 mask75; do
    wait "${PIDS[$i]}"
    rc=$?
    echo "$(date -Is) ${tag} exit=${rc}"
    [[ $rc -ne 0 ]] && FAIL=1
    i=$((i + 1))
done

echo "$(date -Is) all done; per-tier logs in ${LOGDIR}/*.out, alignment.json in each run dir"
exit $FAIL
