#!/bin/bash -l
# Why did the zero-shot VALIDATION pass run ~100x slower per layer than the test pass?
# The same 50M encoder on validation (tile 0) and test (tile 1) side by side, every per-layer step timed.
#PBS -N zs-probe
#PBS -A UIC-HPC
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o /home/khuss/code/msdelta/pbs/logs/
set -uo pipefail
cd /home/khuss/code/msdelta
S=/lus/flare/projects/UIC-HPC/khuss/msdelta; E=$S/eval-data
source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/lib/load_frameworks.sh"
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZE_FLAT_DEVICE_HIERARCHY=FLAT PYTHONPATH=$PWD OMP_NUM_THREADS=8
export HF_HOME=$S/huggingface HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
O=results/raw/finetune/contrastive/zs-probe; mkdir -p $O/val $O/test
M=$O/models.txt; echo "zs_050m_ck540k /flare/UIC-HPC/khuss/msdelta/pretrained/msdelta-50m-production-01-checkpoint-540423" > $M
ZE_AFFINITY_MASK=0 .venv/bin/python pbs/diag/zs_timing_probe.py --models $M --data $E/ms-contrastive-100k-validation-mp512 \
  --out-dir $O/val --abtt 8,32,64,128 --fit-data $E/ms-contrastive-100k-train10k-mp512 > $O/val.log 2>&1 &
ZE_AFFINITY_MASK=1 .venv/bin/python pbs/diag/zs_timing_probe.py --models $M --data $E/ms-contrastive-100k-test-mp512 \
  --out-dir $O/test --abtt 8,32,64,128 --fit-data $E/ms-contrastive-100k-train10k-mp512 > $O/test.log 2>&1 &
wait
for s in val test; do echo "== $s"; grep -E "\[probe\]|block0[0-3]:|s\): final" $O/$s.log | head -30; done
