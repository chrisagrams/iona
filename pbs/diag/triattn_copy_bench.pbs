#!/bin/bash -l
# K117-P: SDPA triangle attention -- copy vs attention-kernel time (profiler), copy-free
# expand()-view mask and prebuilt-mask variants, N = 200/256/512 (pbs/diag/triattn_copy_bench.py).
#
#   qsub -q debug -l select=1 -l walltime=01:00:00 -A UIC-HPC -l filesystems=home:flare \
#        -v REPO_DIR=$PWD pbs/diag/triattn_copy_bench.pbs
#
# One tile. Expected < 30 min (the script stops starting new sizes after 40 min and writes what
# it has). Output: $MSDELTA_DIAG/triattn_copy_bench/<jobid>.json (+ .log, and
# <jobid>_traces/ with the gzipped profiler traces of B=2, N=200).

#PBS -N msdelta-tricopy
#PBS -A UIC-HPC
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/lib/homes.sh" || exit 1   # K198a: data homes (configs/homes.env)
cd "$REPO_DIR"

set +u
source /usr/share/lmod/lmod/init/bash
source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/lib/load_frameworks.sh" || exit 3
set -u
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Run from a frozen copy of the code (pbs/lib/code_snapshot.sh).
source "$REPO_DIR/pbs/lib/code_snapshot.sh"
PY="$REPO_DIR/.venv/bin/python"
JOB=${PBS_JOBID%%.*}; JOB=${JOB:-local}
O=$MSDELTA_DIAG/triattn_copy_bench; mkdir -p "$O"

echo "=== $(date -Is) triattn copy bench on $(hostname), job $JOB"
# qsub -v cannot carry commas: BENCH_BATCHES / BENCH_PEAKS use "+" between values (e.g. BENCH_PEAKS=150+200).
ARGS=()
[[ -n ${BENCH_BATCHES:-} ]] && ARGS+=(--batches "${BENCH_BATCHES//+/,}")
[[ -n ${BENCH_PEAKS:-} ]] && ARGS+=(--peaks "${BENCH_PEAKS//+/,}")
[[ -n ${BENCH_TRACE:-} ]] && ARGS+=(--trace-sizes "${BENCH_TRACE//+/,}")
"$PY" "$MSDELTA_CODE_DIR"/pbs/diag/triattn_copy_bench.py --out "$O/$JOB.json" "${ARGS[@]}" 2>&1 | tee "$O/$JOB.log"
rc=${PIPESTATUS[0]}
echo "=== $(date -Is) done (rc=$rc)"
exit $rc
