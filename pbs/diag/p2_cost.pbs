#!/bin/bash -l
#PBS -N p2-cost
#PBS -A UIC-HPC
#PBS -l select=2
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/
# K159-P: step time of the P2 Pairformer arms vs per-tile micro-batch, to price fewer-node runs.
# 2 nodes x 12 tiles, global batch 576 (the P2 runs' batch), stop at step 300, no eval, W&B off.
# Arms are <config>:<micro>; accumulation = 576 / (24 x micro): micro 3 -> 8, 12 -> 2, 24 -> 1.
# Step time = (elapsed at step 300 - elapsed at step 150) / 150, from the progress bar. The first few
# hundred steps run slower than steady state (16-node k1: 0.24 s/step at 200-300 vs 0.15 at 5100-5900),
# so k1:3 is the control that ties this window to the 16-node runs.
# K162-P: an arm <config>:<micro>:c runs with torch.compile (TORCH_COMPILE=1 in aurora-pretrain.pbs); compile
# time falls in the first steps, outside the 150-300 window (recompiles, if any, show as a slower window).
# Memory: an out-of-memory arm is itself the answer (that micro-batch does not fit without checkpointing).
#   qsub -q debug -v REPO_DIR=$PWD pbs/diag/p2_cost.pbs        (ARMS=a:12+b:24:c to pick arms)
# K189-P: PREPROC=<preprocessed dir> runs the arms on other data (default: the P2 set).
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
set -uo pipefail
S=/lus/flare/projects/UIC-HPC/khuss/msdelta
JOB=${PBS_JOBID%%.*}; JOB=${JOB:-local}
SM=$S/runs/p2-cost/$JOB; mkdir -p "$SM"
ARMS=${ARMS:-p2-cz32-k1:24+p2-cz32-k1:12+p2-cz32-k1:3+p2-cz32-k1-triattn:24+p2-cz32-k1-triattn:12+p2-cz32-k5:24}
elapsed() {  # seconds on the progress bar at step $2 in file $1
    tr '\r' '\n' < "$1" | grep -o " $2/540423 \[[0-9:]*" | head -1 | grep -o "[0-9:]*$" \
        | awk -F: '{s=0; for (i=1; i<=NF; i++) s = s*60 + $i; print s}'
}
for spec in ${ARMS//+/ }; do
    IFS=: read -r arm micro comp <<<"$spec"; tag=$arm-m$micro${comp:+-compile}
    [[ $comp == c ]] && compile=1 || compile=0
    sed -e 's/^--eval_strategy .*/--eval_strategy no/' -e 's/^--save_steps .*/--save_steps 300/' \
        -e 's/^--logging_steps .*/--logging_steps 10/' -e 's/^--report_to .*/--report_to none/' \
        "configs/p2/$arm/training.args" > "$SM/$tag.args"
    echo "=== $(date -Is) $tag"
    timeout 600 env ARGS_FILE="$SM/$tag.args" CHECKPOINT_DIR="$SM" RUN_NAME="p2cost-$tag-$JOB" \
        HF_HOME=$S/huggingface PREPROCESSED_DATASET_DIR=${PREPROC:-$S/data/p2-cap150-half/preprocessed} \
        XPUS_PER_HOST=12 MICRO_BATCH_SIZE=$micro GLOBAL_BATCH_SIZE=576 TORCH_COMPILE=$compile PROBE_EXECUTION=off CCL_KVS_MODE=pmi \
        WANDB_MODE=disabled MSDELTA_STOP_AT_STEP=300 bash pbs/aurora-pretrain.pbs > "$SM/$tag.log" 2>&1
    rc=$?
    err=$(find "$SM/p2cost-$tag-$JOB" -name "train-*.err" 2>/dev/null | head -1)
    t150=$( [[ -n $err ]] && elapsed "$err" 150 ); t300=$( [[ -n $err ]] && elapsed "$err" 300 )
    oom=$(grep -l -i -E "out of memory|UR_RESULT_ERROR_OUT_OF_DEVICE_MEMORY" "$SM/$tag.log" $err 2>/dev/null | wc -l)
    if [[ -n $t150 && -n $t300 ]]; then
        sps=$(awk -v a="$t150" -v b="$t300" 'BEGIN{printf "%.3f", (b-a)/150}')
    else sps=NA; fi
    echo "RESULT $tag rc=$rc micro=$micro compile=$compile s_per_step=$sps t150=${t150:-NA} t300=${t300:-NA} oom=$oom"
done | tee "$SM/summary.txt"
exit 0
