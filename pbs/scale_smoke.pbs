#!/bin/bash
#PBS -N msdelta_smoke
#PBS -A FRAME-IDP
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:10:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# 10-min debug-queue smoke for the v11 capacity sweep. Same fan-out as
# scale_all.pbs (4 tiers, one per GPU) but SMOKE=1 shortens the schedule
# to 100 steps (warmup 20, log every 10, val once, render bias curves
# + save ckpt at end, probe skipped). Verifies end-to-end pipeline:
#   - venv + torch + cuda see the local GPU
#   - eagle parquet path resolves, dataloader streams row-groups
#   - all 4 tier sizes fit in 40 GB at their configured batch sizes
#   - wandb auth works through the ALCF proxy (project: msdelta-scale-smoke)
#   - checkpoints + bias-curve PNGs land in runs/scale_<tier>_<jobid>/
#
# If this passes cleanly, scale_all.pbs is ready to submit.

set -euo pipefail

REPO=/home/cgrams/msdelta
cd "$REPO"

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

echo "$(date -Is) SMOKE job=$PBS_JOBID host=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
nvidia-smi -L | sed "s/^/  /"

export SMOKE=1

CONFIGS=(configs/scale_S.yaml configs/scale_M.yaml configs/scale_L.yaml configs/scale_XL.yaml)
PIDS=()
for i in "${!CONFIGS[@]}"; do
    cfg=${CONFIGS[$i]}
    gpu=$i
    bash "$REPO/pbs/_run_tier.sh" "$cfg" "$gpu" &
    PIDS+=($!)
    echo "$(date -Is) launched cfg=$cfg gpu=$gpu pid=$!"
done

set +e
FAIL=0
for i in "${!CONFIGS[@]}"; do
    cfg=${CONFIGS[$i]}
    wait "${PIDS[$i]}"
    rc=$?
    echo "$(date -Is) cfg=$cfg exit=$rc"
    if [[ $rc -ne 0 ]]; then
        FAIL=1
    fi
done

exit $FAIL
