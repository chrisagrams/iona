#!/bin/bash -l
# Score saved contrastive encoders on retrieval, and against the separation ratio.
#
#   qsub -q debug -l select=1 -l walltime=00:50:00 \
#        -v JOB=8848049,BASELINE=/flare/UIC-HPC/khuss/msdelta/pretrained/msdelta-50m-production-01-checkpoint-133233 \
#        pbs/eval_retrieval.pbs
#
# Eval only -- it reads each arm's final/ and retrains nothing. One tile is enough;
# the work is embedding a couple of thousand spectra per arm.

#PBS -N msdelta-evalret
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
JOB=${JOB:?set JOB to the sweep job id whose arms to score}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
PROJECT=${PROJECT:-UIC-HPC}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/$PROJECT/$USER/msdelta}

set +u
source /usr/share/lmod/lmod/init/bash
source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/lib/load_frameworks.sh"
set -u

export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Run from a frozen copy of the code (pbs/lib/code_snapshot.sh): branch switches and
# edits in the checkout cannot affect this job once it has started.
source "$REPO_DIR/pbs/lib/code_snapshot.sh"
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}

# Name the output for what it holds. A filtered run must not overwrite a full-job
# file, and two halves of one split must not overwrite each other.
if [[ -n ${OUT_TAG:-} ]]; then SUFFIX="_$OUT_TAG"
elif [[ -n ${ARMS:-} ]]; then SUFFIX="_sel"
else SUFFIX=""
fi

"$VENV_DIR/bin/python" -m msdelta.eval_retrieval \
    --job "$JOB" ${BASELINE:+--baseline "$BASELINE"} \
    ${ARMS:+--arms "$ARMS"} \
    --runs "$SCRATCH_ROOT/runs" \
    --out "results/raw/finetune/contrastive/retrieval_vs_separation_${JOB}${SUFFIX}.json"
