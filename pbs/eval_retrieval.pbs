#!/bin/bash -l
# Score saved contrastive encoders on retrieval, and against the separation ratio.
#
#   qsub -q debug -l select=1 -l walltime=00:50:00 \
#        -v JOB=8848049,BASELINE=/flare/UIC-HPC/khuss/msdelta/pretrained/msdelta-50m-production-01-checkpoint-133233 \
#        pbs/eval_retrieval.pbs
#
# Eval only -- it reads each arm's final/ and retrains nothing. One tile is enough;
# the work is embedding a couple of thousand spectra per arm.

#PBS -N msdelta-evalret
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
JOB=${JOB:?set JOB to the sweep job id whose arms to score}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
PROJECT=${PROJECT:-UIC-HPC}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/$PROJECT/$USER/msdelta}

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u

export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}

"$VENV_DIR/bin/python" -m msdelta.eval_retrieval \
    --job "$JOB" ${BASELINE:+--baseline "$BASELINE"} \
    --runs "$SCRATCH_ROOT/runs" \
    --out "results/retrieval_vs_separation_$JOB.json"
