#!/bin/bash -l
# PSM reranking, stage 1b (hand-built features, CPU) + stage 2 (FDR, all rescorers).
#
#   qsub -q debug -l select=1 -l walltime=01:00:00 -v TAG=a1-050m-c7s600,RUNS="..." \
#        pbs/rerank_psm_stage2.pbs
#
# Reads stage 1's rows from $SCRATCH/rerank-psm/$TAG/rows; existing tables are reused.

#PBS -N msdelta-rerank-psm2
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
TAG=${TAG:?set TAG}; RUNS=${RUNS:?set RUNS}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/${PROJECT:-UIC-HPC}/$USER/msdelta}
BASE=$SCRATCH_ROOT/rerank-psm/$TAG
set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZE_FLAT_DEVICE_HIERARCHY=FLAT ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-16}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
PY="$VENV_DIR/bin/python"

mkdir -p "$BASE/handfeat"
echo "=== $(date -Is) stage 1b: hand-built features"
pids=()
for run in $RUNS; do
    out="$BASE/handfeat/$(basename "$run")"
    [[ -f $out ]] && continue
    OMP_NUM_THREADS=1 "$PY" "$REPO_DIR/scripts/rerank_psm_handfeat.py" --run "$run" --out "$out" \
        > "$BASE/handfeat/.$(basename "$run").log" 2>&1 &
    pids+=($!)
done
for p in "${pids[@]}"; do wait "$p"; done
grep -h "handfeat\]\|Error" "$BASE"/handfeat/.*.log | cut -c1-200
echo "=== $(date -Is) stage 2: FDR"
"$PY" "$REPO_DIR/scripts/rerank_psm_fdr.py" --rows "$BASE/rows" --handfeat "$BASE/handfeat" \
    --out "results/rerank/psm/${TAG}_full.json"
