#!/bin/bash -l
# Re-score finished winners so the headline AUROC can be read against a within-spectrum
# one.
#
#   qsub -q debug -l select=1 -l walltime=00:55:00 \
#        -v ARMS="/path/to/arm1 /path/to/arm2" pbs/backfill_per_spectrum.pbs
#
# denoise_metrics now reports auroc_per_spectrum alongside the pooled auroc, but only
# for runs made after the change. The grids that matter are already finished, and
# re-running them costs node-hours; re-EVALUATING a saved checkpoint costs minutes, so
# the comparison can be had for almost nothing.
#
# Why it matters: pooled AUROC ranks peaks against peaks from OTHER spectra, and the
# model is used one spectrum at a time. A per-spectrum offset -- scoring noisy spectra
# above clean ones -- inflates the pooled number without helping the actual task. A
# model useless inside every spectrum can score 0.64 pooled; there is a test for exactly
# that case. The same gap already cost this project once, when a reranking feature
# scored 0.846 pooled and lost 0.109 hit@1.

#PBS -N msdelta-backfill
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
ARMS=${ARMS:?set ARMS to a space-separated list of finished arm directories}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/UIC-HPC/$USER/msdelta}
XPUS_PER_HOST=${XPUS_PER_HOST:-12}

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-$(seq -s, 0 $((XPUS_PER_HOST - 1)))}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_KVS_MODE=mpi
unset CCL_ZE_IPC; unset CCL_ZE_IPC_EXCHANGE
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Run from a frozen copy of the code (pbs/lib/code_snapshot.sh): branch switches and
# edits in the checkout cannot affect this job once it has started.
source "$REPO_DIR/pbs/lib/code_snapshot.sh"
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1

HOSTFILE=$SCRATCH_ROOT/runs/.hostfile-backfill-$PBS_JOBID
sort -u "${PBS_NODEFILE:?}" | head -1 > "$HOSTFILE"
export MASTER_ADDR=$(head -1 "$HOSTFILE") MASTER_PORT=${MASTER_PORT:-29500}
export MSDELTA_XPUS_PER_HOST=$XPUS_PER_HOST MSDELTA_WORLD_SIZE=$XPUS_PER_HOST

# Twelve tiles, matching how these arms trained, so the gather path that produces the
# number is the same one that produced the number being compared against.
for dir in $ARMS; do
    [[ -d $dir ]] || { echo "  [$dir] missing"; continue; }
    job=${dir##*-}
    name=$(basename "$dir"); name=${name#sweep-}; name=${name%-$job}
    args=$SCRATCH_ROOT/runs/.configs-$job/$name/training.args
    [[ -f $args ]] || { echo "  [$name] no snapshot at $args"; continue; }
    final=$(ls -d "$dir"/checkpoint-* 2>/dev/null | sed 's/.*checkpoint-//' | sort -n | tail -1)
    [[ -n $final ]] || { echo "  [$name] no checkpoints"; continue; }
    echo
    echo "############ $name  (checkpoint-$final)"
    mpiexec --envall --pmi=pmix -n "$XPUS_PER_HOST" --ppn "$XPUS_PER_HOST" \
        --cpu-bind depth --depth "${CPU_DEPTH:-8}" --hostfile="$HOSTFILE" \
        "$MSDELTA_CODE_DIR/pbs/rank_wrapper.sh" \
        "$VENV_DIR/bin/python" -m msdelta.eval_checkpoint \
            --args_file "$args" --checkpoint "$dir/checkpoint-$final" \
            --results_into "$dir/per_spectrum" --weights_selected_by final \
            --output_dir "$dir/.backfill" \
        > "$dir/backfill-$PBS_JOBID.log" 2>&1 \
        && grep -oE '"test_auroc[a-z_0-9]*": [0-9.]+|"test_spectra_[a-z]+": [0-9.]+' \
               "$dir/per_spectrum/test_results.json" 2>/dev/null | sed 's/^/    /' \
        || { echo "    FAILED, see $dir/backfill-$PBS_JOBID.log"
             tail -4 "$dir/backfill-$PBS_JOBID.log"; }
done
echo
echo "=== compare auroc_per_spectrum against the pooled test_auroc in each arm ==="
