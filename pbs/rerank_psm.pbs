#!/bin/bash -l
# PSM reranking on Gaolaboratory/psm-rerank-hek-hct116: embed + hand-built features per run,
# spread over nodes x tiles, then PSMs/peptides at 1% FDR.
#
#   qsub -q debug -l select=1 -l walltime=01:00:00 \
#        -v TAG=...,DATASET=Gaolaboratory/psm-rerank-hek-hct116,REVISION=...,RUNS_FILE=...,ENCODER=...,STUDENT=...,CACHE=... \
#        pbs/rerank_psm.pbs
#
# RUNS_FILE lists runs in DATASET (e.g. HEK293/0718-1.parquet), one per line; REVISION is optional. Per-run tables go to
# $SCRATCH_ROOT/rerank-psm/$TAG/{rows,handfeat}; existing ones are reused, so resubmit to
# resume. The FDR report goes to results/rerank/psm/$TAG.json.

#PBS -N msdelta-rerank-psm
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail

# Worker mode: one per node, launched by mpiexec below. Each tile walks a strided share of
# the runs.
if [[ ${1:-} == worker ]]; then
    RANK=${PMIX_RANK:-${PMI_RANK:-${PALS_RANKID:-0}}}
    RUNS=(); while IFS= read -r run; do RUNS+=("$run"); done < <(grep -v '^#' "$RUNS_FILE" | sed '/^$/d')
    cd "$REPO_DIR"
    for (( t = 0; t < TILES; t++ )); do
      (
        slot=$(( RANK * TILES + t )); stride=$(( NNODES * TILES ))
        for (( i = slot; i < ${#RUNS[@]}; i += stride )); do
          run=${RUNS[$i]}; name=$(basename "$run")
          rows="$BASE/rows/$name"; hand="$BASE/handfeat/$name"; log="$BASE/logs/$name.log"
          if [[ ! -f $rows ]]; then
            ZE_AFFINITY_MASK=$t "$PY" "$REPO_DIR/scripts/rerank_psm_embed.py" --run "$run" \
              --repo "$DATASET" ${REVISION:+--revision "$REVISION"} \
              --encoder "$ENCODER" --student "$STUDENT" --cache "$CACHE" --out "$rows.tmp" \
              >> "$log" 2>&1 && mv "$rows.tmp" "$rows" \
              || { echo "[node $RANK tile $t] EMBED FAILED $run"; continue; }
          fi
          if [[ ! -f $hand ]]; then
            OMP_NUM_THREADS=1 "$PY" "$REPO_DIR/scripts/rerank_psm_handfeat.py" --run "$run" \
              --repo "$DATASET" ${REVISION:+--revision "$REVISION"} \
              --out "$hand.tmp" >> "$log" 2>&1 && mv "$hand.tmp" "$hand" \
              || echo "[node $RANK tile $t] HANDFEAT FAILED $run"
          fi
          echo "[node $RANK tile $t] done $run"
        done
      ) &
    done
    wait
    exit 0
fi

export REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
export TAG=${TAG:?set TAG}
export DATASET=${DATASET:?set DATASET to the PSM dataset repo}
export REVISION=${REVISION:-}
export RUNS_FILE=${RUNS_FILE:?set RUNS_FILE to a file listing runs, one per line}
export ENCODER=${ENCODER:?set ENCODER to the contrastive encoder checkpoint}
export STUDENT=${STUDENT:?set STUDENT to the alignment run final/ directory}
export CACHE=${CACHE:?set CACHE to the teacher-embedding cache}
export TILES=${TILES:-12}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/${PROJECT:-UIC-HPC}/$USER/msdelta}
export BASE=$SCRATCH_ROOT/rerank-psm/$TAG
export PY=${VENV_DIR:-$REPO_DIR/.venv}/bin/python
mkdir -p "$BASE/rows" "$BASE/handfeat" "$BASE/logs"

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
source "$REPO_DIR/pbs/load_keys.sh"
set -u
[[ -n ${HF_TOKEN:-} ]] || { echo "HF_TOKEN not loaded" >&2; exit 2; }
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZE_FLAT_DEVICE_HIERARCHY=FLAT ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface} HF_HUB_OFFLINE=0 HF_DATASETS_OFFLINE=0
ALCF_PROXY=${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTP_PROXY=$ALCF_PROXY HTTPS_PROXY=$ALCF_PROXY http_proxy=$ALCF_PROXY https_proxy=$ALCF_PROXY
export no_proxy="admin,localhost,*.cm.aurora.alcf.anl.gov,aurora-*,*.aurora.alcf.anl.gov,*.alcf.anl.gov,127.0.0.1"
export NO_PROXY=$no_proxy
export NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)

echo "=== $(date -Is) stage 1: $(grep -v '^#' "$RUNS_FILE" | sed '/^$/d' | wc -l) runs on" \
     "$NNODES nodes x $TILES tiles; $(ls "$BASE/rows" | wc -l) already embedded"
mpiexec --envall --pmi=pmix -n "$NNODES" --ppn 1 --cpu-bind none \
    bash "$REPO_DIR/pbs/rerank_psm.pbs" worker
echo "=== $(date -Is) rows $(ls "$BASE/rows"/*.parquet | wc -l)," \
     "handfeat $(ls "$BASE/handfeat"/*.parquet | wc -l)"

echo "=== $(date -Is) stage 2: FDR"
"$PY" "$REPO_DIR/scripts/rerank_psm_fdr.py" --rows "$BASE/rows" --handfeat "$BASE/handfeat" \
    --out "results/rerank/psm/$TAG.json"
