#!/bin/bash -l
# PSM reranking on Gaolaboratory/psm-rerank-hek-hct116: embed, then PSMs/peptides at 1% FDR.
#
#   qsub -q debug -l select=1 -l walltime=01:00:00 \
#        -v TAG=a1-050m,RUNS="HEK293/0718-1.parquet ...",ENCODER=...,STUDENT=...,CACHE=... \
#        pbs/rerank_psm.pbs
#
# Stage 1 embeds one run per tile (existing tables reused); stage 2 writes
# results/rerank/psm/$TAG.json. SAVE_VECTORS=1 (default) also saves the unit vectors.

#PBS -N msdelta-rerank-psm
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
TAG=${TAG:?set TAG}; RUNS=${RUNS:?set RUNS}
ENCODER=${ENCODER:?set ENCODER}; STUDENT=${STUDENT:?set STUDENT}; CACHE=${CACHE:?set CACHE}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/${PROJECT:-UIC-HPC}/$USER/msdelta}
ROWS=${ROWS:-$SCRATCH_ROOT/rerank-psm/$TAG/rows}
SAVE_VECTORS=${SAVE_VECTORS-1}     # R5; SAVE_VECTORS= (empty) to skip

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
source "$REPO_DIR/pbs/load_keys.sh"
set -u
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=0 HF_DATASETS_OFFLINE=0
ALCF_PROXY=${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTP_PROXY=$ALCF_PROXY HTTPS_PROXY=$ALCF_PROXY http_proxy=$ALCF_PROXY https_proxy=$ALCF_PROXY
export no_proxy="admin,localhost,*.cm.aurora.alcf.anl.gov,aurora-*,*.aurora.alcf.anl.gov,*.alcf.anl.gov,127.0.0.1"
export NO_PROXY=$no_proxy
[[ -n ${HF_TOKEN:-} ]] || { echo "HF_TOKEN not loaded" >&2; exit 2; }
PY="$VENV_DIR/bin/python"

mkdir -p "$ROWS"
echo "=== $(date -Is) stage 1: embed"
i=0; pids=()
for run in $RUNS; do
    out="$ROWS/$(basename "$run")"
    if [[ -f $out ]]; then echo "  reuse $out"; continue; fi
    ZE_AFFINITY_MASK=$i "$PY" -m msdelta.rerank_psm_embed --run "$run" --encoder "$ENCODER" \
        --student "$STUDENT" --cache "$CACHE" --out "$out" \
        ${SAVE_VECTORS:+--vectors-out "$SCRATCH_ROOT/rerank-psm/$TAG/vectors/$(basename "$run" .parquet)"} \
        > "$ROWS/.$(basename "$run").log" 2>&1 &
    pids+=($!); i=$((i + 1))
done
failed=0
for p in "${pids[@]}"; do wait "$p" || failed=1; done
grep -h "\[embed\] wrote\|Error\|Traceback" "$ROWS"/.*.log | cut -c1-200
(( failed )) && echo "  WARNING: some runs failed; stage 2 uses the tables that exist"

echo "=== $(date -Is) stage 2: FDR"
"$PY" -m msdelta.rerank_psm_fdr --rows "$ROWS" --out "results/rerank/psm/$TAG.json"
