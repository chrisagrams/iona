#!/bin/bash -l
# Train the rescoring classifier with and without embedding_cosine, and compare.
#
#   qsub -q debug -l select=1 -l walltime=00:30:00 \
#        -v TARGET_CACHE=...,STUDENT=... pbs/rescoring.pbs
#
# Feature extraction is numpy and the classifier is a 128-wide MLP, so this is CPU work
# on one node -- but it loads the alignment student to compute embedding_cosine and runs
# over the whole corpus, which is more than belongs on a login node.

#PBS -N msdelta-rescore
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -euo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
SCRATCH=/lus/flare/projects/UIC-HPC/$USER/msdelta
TARGET_CACHE=${TARGET_CACHE:-$SCRATCH/align-targets-contrastive}
STUDENT=${STUDENT:-$SCRATCH/runs/v2_align-contrastive-1tile-8840739/final}
SPLIT=${SPLIT:-validation}

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u
# Level Zero settings, the same ones every other launcher here sets before running
# python. This job is CPU work, but importing torch still initialises XPU, and on a
# compute node without the flat hierarchy and an affinity mask that enumeration
# segfaults before Python can report anything -- jobs 8840898 and 8840907 died with a
# bare "Segmentation fault" and no traceback even under -X faulthandler, while every
# component ran fine on a login node. One tile is plenty; nothing here uses the GPU.
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-0}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export HF_HOME=${HF_HOME:-$SCRATCH/huggingface}
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-8}

# W&B: same project as the alignment runs, grouped by WANDB_GROUP (e.g. the teacher), so
# a teacher's student and its rescoring result sit together. WANDB_PROJECT="" turns it off.
WANDB_PROJECT=${WANDB_PROJECT-msdelta-finetune-align}
if [[ -n $WANDB_PROJECT ]]; then
    set +u; source "$REPO_DIR/pbs/load_keys.sh"; set -u
    # Compute nodes reach the internet only through the ALCF proxy. Without it wandb.init
    # timed out after 90 s (job 8857760); aurora-finetune.pbs sets the same block.
    ALCF_PROXY=${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}
    export HTTP_PROXY=${HTTP_PROXY:-$ALCF_PROXY} HTTPS_PROXY=${HTTPS_PROXY:-$ALCF_PROXY}
    export http_proxy=${http_proxy:-$ALCF_PROXY} https_proxy=${https_proxy:-$ALCF_PROXY}
    export no_proxy="${no_proxy:-admin,localhost,*.cm.aurora.alcf.anl.gov,aurora-*,*.aurora.alcf.anl.gov,*.alcf.anl.gov},127.0.0.1"
    export NO_PROXY="${NO_PROXY:-$no_proxy},127.0.0.1"
fi

echo "=== rescoring: $(date -Is) ==="
echo "  cache   : $TARGET_CACHE"
echo "  student : $STUDENT"
[[ -d $TARGET_CACHE/$SPLIT ]] || { echo "no cache at $TARGET_CACHE/$SPLIT" >&2; exit 2; }
[[ -f $STUDENT/model.safetensors ]] || { echo "no student at $STUDENT" >&2; exit 2; }

# -X faulthandler: the first attempt (8840898) died with a bare "Segmentation fault"
# and no traceback, before the script printed anything, so there was nothing to act on.
# faulthandler turns a C-level crash into a Python stack.
"$VENV_DIR/bin/python" -X faulthandler -u -m msdelta.run_rescoring \
    --target_cache "$TARGET_CACHE" --student "$STUDENT" --split "$SPLIT" \
    --epochs "${EPOCHS:-40}" --seed "${SEED:-0}" --seeds "${SEEDS:-5}" \
    --out "$REPO_DIR/pbs/logs/rescoring-${PBS_JOBID%%.*}.json" \
    --wandb_project "$WANDB_PROJECT" --wandb_group "${WANDB_GROUP:-}" ${EXTRA_ARGS:-}
