#!/bin/bash
#PBS -N msdelta_v14
#PBS -A FRAME-IDP
#PBS -q capacity
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=20:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# v14 — capacity sweep ON KL LOSS. The clean re-run of v11: v11 swept
# capacity (d=384..1024) but on the broken MSE target (constant-predict
# floor, no gradient), so it could not detect a capacity effect on
# chemistry. v13 fixed the loss (KL) but only at d=256. This sweep is the
# missing cell: capacity × working-loss.
#
# One config per A100-40GB: v14_cap_{S,M,L,XL}.yaml (d=384/512/768/1024),
# KL loss, mask_ratio=0.50 (v13 sweet spot), equal data exposure (~12.8M
# spectra each), baseline arch (charge/precursor OFF) to isolate capacity.
#
# THE point of this run is the inline-probe trajectory: each tier logs
# align/* (bias-curve chemistry alignment) and retrieval/* every 5k steps,
# so we can watch whether bias chemistry sharpens with training AND scales
# with capacity — rather than only reading the final checkpoint.
#
# Capacity (v11 timings at MSE): S 4.62 / M 4.31 / L 4.14 / XL 3.45 sps →
# XL 160k steps ≈ 13h compute. KL softmax + inline retrieval probes add a
# little; 20h walltime gives margin.
#
# Reads (wandb msdelta-capacity-kl, per tier over training):
#   align/n_sig01_bonf   — heads surviving x16 Bonferroni (the strict gate)
#   align/n_sig05        — heads beating chance at p<0.05
#   align/best_p, *_max_enrich, *_coverage
#   retrieval/mAP, retrieval/gap_vs_binned  — embedding vs binned baseline
#   probe/fragment_mz_r2, probe/isotope_f1, ...  — linear-probe suite
# Verdict: align/n_sig01_bonf climbs S→XL → capacity IS the lever under a
# working loss (v13 conclusion was premature). Flat across tiers → it's the
# task incentive; proceed to ELECTRA (§6).
#
# Pre-req: pbs/setup_venv.sh run once on the login node.

set -euo pipefail

REPO=/home/cgrams/msdelta
cd "$REPO"

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

echo "$(date -Is) job=$PBS_JOBID host=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
nvidia-smi -L | sed "s/^/  /"

CONFIGS=(
    configs/v14_cap_S.yaml
    configs/v14_cap_M.yaml
    configs/v14_cap_L.yaml
    configs/v14_cap_XL.yaml
)
PIDS=()
for i in "${!CONFIGS[@]}"; do
    cfg=${CONFIGS[$i]}
    gpu=$i
    bash "$REPO/pbs/_run_tier.sh" "$cfg" "$gpu" &
    PIDS+=($!)
    echo "$(date -Is) launched cfg=$cfg gpu=$gpu pid=$!"
done

set +e
FAIL=0
for i in "${!CONFIGS[@]}"; do
    cfg=${CONFIGS[$i]}
    wait "${PIDS[$i]}"
    rc=$?
    echo "$(date -Is) cfg=$cfg exit=$rc"
    if [[ $rc -ne 0 ]]; then
        FAIL=1
    fi
done

exit $FAIL
