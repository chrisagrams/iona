#!/bin/bash -l
# Fine-tune a pretrained encoder for per-peak noise classification on Aurora.
#
#   qsub -q debug -l select=1 -l walltime=01:00:00 \
#        -v ARGS_FILE=configs/finetune-denoise-50m/training.args,MAX_STEPS=60 \
#        pbs/aurora-finetune.pbs
#
#   qsub -q capacity -l select=1 -l walltime=06:00:00 \
#        -v ARGS_FILE=configs/finetune-denoise-50m/training.args \
#        pbs/aurora-finetune.pbs
#
# Simpler than pbs/aurora-pretrain.pbs on purpose: no telegraf sidecar, no probe
# subprocesses, no DeepSpeed. One model, one dataset, one Trainer.
#
# MAX_STEPS exists for the debug-queue timing pass. Debug caps at 1h, which is not enough
# to finish, so a short capped run measures steps/second and the resulting number sizes
# the capacity walltime instead of guessing it.

#PBS -N msdelta-denoise-ft
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -euo pipefail

REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
PROJECT=${PROJECT:-UIC-HPC}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/$PROJECT/$USER/msdelta}
ARGS_FILE=${ARGS_FILE:?set ARGS_FILE to a denoise finetune args file}
# 12, not 8: Aurora is 6 Max 1550 GPUs x 2 tiles, and FLAT hierarchy exposes all twelve.
# aurora-pretrain.pbs defaults to 8 because it reserves tiles 4,5 and 10,11 for the probe
# sidecars; this job has none, so using 8 would idle a third of the node.
XPUS_PER_HOST=${XPUS_PER_HOST:-12}
# Which entry point to launch. The environment, proxy, credentials, preflight and rank
# wiring are identical for every fine-tuning task, so they live here once rather than
# being copied per task and drifting apart.
MODULE=${MODULE:-msdelta.finetune_denoise}
[[ $ARGS_FILE == /* ]] || ARGS_FILE=$REPO_DIR/$ARGS_FILE
[[ -f $ARGS_FILE ]]    || { echo "args file not found: $ARGS_FILE" >&2; exit 2; }
[[ -x $VENV_DIR/bin/python ]] || { echo "no venv at $VENV_DIR" >&2; exit 2; }

# Name the run after the task, not after "denoise": this launcher is shared, and a
# mislabelled run directory is the kind of thing that is only noticed weeks later.
TASK=${TASK:-$(basename "${MODULE#*finetune_}")}
# Every run before this prefix existed was produced by a pipeline with known bugs -- the
# DDP freeze desync, the GPU page fault, the eval-only dtype crash. Their W&B history is
# not comparable to anything after, and the surest way to stop someone averaging the two
# together six weeks from now is for the names not to match. Bump it, do not remove it.
RUN_PREFIX=${RUN_PREFIX:-v2_}
RUN_NAME=${RUN_NAME:-$TASK-ft-$(basename "$(dirname "$ARGS_FILE")")}
[[ $RUN_NAME == "$RUN_PREFIX"* ]] || RUN_NAME=$RUN_PREFIX$RUN_NAME
JOB_ID=${PBS_JOBID:-local}; JOB_ID=${JOB_ID%%.*}
RUN_DIR=$SCRATCH_ROOT/runs/$RUN_NAME-$JOB_ID
LOG_DIR=$RUN_DIR/logs
mkdir -p "$LOG_DIR" "$REPO_DIR/pbs/logs"

NUM_HOSTS=$(wc -l < "${PBS_NODEFILE:?PBS_NODEFILE is required}")
TOTAL_XPUS=$((NUM_HOSTS * XPUS_PER_HOST))

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u

# Level Zero only, flat hierarchy. The module now defaults ONEAPI_DEVICE_SELECTOR to
# "opencl:gpu;level_zero:gpu", which double-counts every tile; forcing it back keeps the
# device count equal to what the launcher assumes.
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
# Job-wide, listing every tile -- NOT one tile per rank. Each rank must see all of them
# so that torch.xpu.set_device(LOCAL_RANK) can pick its own; pinning a rank to a single
# tile leaves it with one visible device at index 0 and set_device(7) then raises
# "device index out of range", which killed job 8839150.
export ZE_AFFINITY_MASK=${ZE_AFFINITY_MASK:-$(seq -s, 0 $((XPUS_PER_HOST - 1)))}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-4}
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_KVS_MODE=mpi
export FI_MR_CACHE_MONITOR=${FI_MR_CACHE_MONITOR:-userfaultfd}
# Recommended by the ALCF Aurora known-issues page for jobs at scale. They tune the
# CXI completion queues and overflow buffers, which are undersized by default for
# many-rank jobs, and TMPDIR keeps scratch off a shared filesystem.
export FI_CXI_DEFAULT_CQ_SIZE=${FI_CXI_DEFAULT_CQ_SIZE:-131072}
export FI_CXI_OFLOW_BUF_SIZE=${FI_CXI_OFLOW_BUF_SIZE:-8388608}
export FI_CXI_CQ_FILL_PERCENT=${FI_CXI_CQ_FILL_PERCENT:-20}
export ZES_ENABLE_SYSMAN=${ZES_ENABLE_SYSMAN:-1}
export TMPDIR=${TMPDIR:-/tmp}
# Diagnostic: force SDPA onto the unfused MATH backend. See reranking.py.
export MSDELTA_SDPA_MATH=${MSDELTA_SDPA_MATH:-}
# Matching aurora-pretrain.pbs, which all-reduces 200M+ parameters successfully. These
# select oneCCL's Level Zero IPC path for device-to-device transfers. It did not matter
# while the DDP reducer held only the 0.082M-parameter head -- the first runs were
# accidentally excluding the encoder -- but every run that actually all-reduces the
# 49.9M-parameter encoder has taken a GPU page fault with them left in place
# (8840007/8/10/11, 8840095).
unset CCL_ZE_IPC
unset CCL_ZE_IPC_EXCHANGE
export MASTER_ADDR=${MASTER_ADDR:-$(head -n 1 "$PBS_NODEFILE")}
export MASTER_PORT=${MASTER_PORT:-29500}
export MSDELTA_XPUS_PER_HOST=$XPUS_PER_HOST
export MSDELTA_WORLD_SIZE=$TOTAL_XPUS
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Probes: dtype, index-range and finiteness checks, and -- the useful part --
# a device synchronise at each stage, so an asynchronous GPU fault is reported
# where it was caused rather than dozens of steps later. Set MSDELTA_PROBES=1 on
# debug runs. Leave it unset for real training: the synchronises serialise the
# queue and cost throughput.
export MSDELTA_PROBES=${MSDELTA_PROBES:-}

# Datasets come from the populated cache; only W&B needs the network.
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}

# Outbound internet. Compute nodes have no route without these, and W&B fails closed --
# it retries, stalls the step loop, and the run dies with no metrics rather than loudly.
ALCF_PROXY=${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTP_PROXY=${HTTP_PROXY:-$ALCF_PROXY}
export HTTPS_PROXY=${HTTPS_PROXY:-$ALCF_PROXY}
export http_proxy=${http_proxy:-$ALCF_PROXY}
export https_proxy=${https_proxy:-$ALCF_PROXY}
export ftp_proxy=${ftp_proxy:-$ALCF_PROXY}
export no_proxy=${no_proxy:-admin,localhost,*.cm.aurora.alcf.anl.gov,aurora-*,*.aurora.alcf.anl.gov,*.alcf.anl.gov}
export no_proxy="$no_proxy,127.0.0.1"
export NO_PROXY="${NO_PROXY:-$no_proxy},127.0.0.1"

# Credentials at runtime, never through `qsub -v`: a job's variable list is world-readable
# through `qstat -f <jobid>`.
source "$REPO_DIR/pbs/load_keys.sh"

export WANDB_DIR=${WANDB_DIR:-$LOG_DIR}
export WANDB_RESUME=${WANDB_RESUME:-allow}
export WANDB_RUN_ID=${WANDB_RUN_ID:-$RUN_NAME-$JOB_ID}

echo "=== msdelta finetune: $MODULE ==="
echo "  job        : $JOB_ID"
echo "  hosts      : $NUM_HOSTS x $XPUS_PER_HOST tiles = $TOTAL_XPUS ranks"
echo "  args       : $ARGS_FILE"
echo "  run dir    : $RUN_DIR"
echo "  wandb run  : $WANDB_RUN_ID"
sed 's/^/  node: /' "$PBS_NODEFILE"

# Preflight. Each of these has cost a job before: a missing W&B key fails only at the
# first log call, and a proxy that cannot reach the outside world looks identical to a
# hung step loop.
"$VENV_DIR/bin/python" -c "
import torch, sys
n = torch.xpu.device_count()
print(f'  torch={torch.__version__} xpus={n} xccl={torch.distributed.is_xccl_available()}')
if n != $XPUS_PER_HOST:
    sys.exit(f'  visible tiles {n} != XPUS_PER_HOST $XPUS_PER_HOST; set_device(LOCAL_RANK) would go out of range')
"
[[ -n ${WANDB_API_KEY:-} ]] || { echo "WANDB_API_KEY not loaded -- see pbs/load_keys.sh" >&2; exit 2; }
# Any HTTP response proves the proxy routed us; api.wandb.ai/ answers a bare GET with
# 404, so --fail would reject a working route (it did, on job 8839139).
wandb_code=$(curl --silent --show-error --max-time 30 -o /dev/null -w '%{http_code}' https://api.wandb.ai || echo 000)
[[ $wandb_code != 000 ]] \
    || { echo "no outbound route to api.wandb.ai through $ALCF_PROXY" >&2; exit 2; }
echo "  wandb      : reachable (HTTP $wandb_code)"
echo "  preflight  : ok"

# Optional first phase: build the target cache in its own SINGLE-PROCESS run, before the
# distributed launch. The training ranks then load targets from disk and never construct
# a teacher. Skipped if the cache already exists, so a rerun costs nothing.
if [[ -n ${PRECOMPUTE_CACHE:-} ]]; then
    EXTRA_PRE=()
    [[ -n ${MAX_SAMPLES:-} ]] && EXTRA_PRE+=(--max_samples "$MAX_SAMPLES")
    if [[ -d $PRECOMPUTE_CACHE/train ]]; then
        echo "  precompute : reusing $PRECOMPUTE_CACHE"
    else
        echo "  precompute : building $PRECOMPUTE_CACHE (one process, one tile)"
        ZE_AFFINITY_MASK=0 "$VENV_DIR/bin/python" -m msdelta.precompute_align             --args_file "$ARGS_FILE" --target_cache "$PRECOMPUTE_CACHE"             --batch_size "${PRECOMPUTE_BATCH:-16}" "${EXTRA_PRE[@]}"             || { echo "precompute failed" >&2; exit 2; }
    fi
fi

EXTRA=()
[[ -n ${PRECOMPUTE_CACHE:-} ]] && EXTRA+=(--target_cache "$PRECOMPUTE_CACHE")
# Independent of the smoke modes below: a full run may still want a different evaluation
# cadence from the config's. At 28,630 steps the config's eval_steps=200 is 143
# evaluations, which is a sixth of a debug hour spent not training.
[[ -n ${EVAL_STEPS:-} ]] && EXTRA+=(--eval_steps "$EVAL_STEPS" --save_steps "$EVAL_STEPS")
# MAX_SAMPLES caps ROWS, so the run finishes real epochs and every end-of-training path
# executes: evaluation, checkpoint writes, save_total_limit rotation,
# load_best_model_at_end, the test pass, the final save. MAX_STEPS stops before all of
# that and is only good for measuring throughput.
if [[ -n ${MAX_SAMPLES:-} ]]; then
    EXTRA+=(--max_samples "$MAX_SAMPLES"
            --eval_steps "${SMOKE_EVAL_STEPS:-25}" --save_steps "${SMOKE_EVAL_STEPS:-25}"
            --logging_steps 5)
elif [[ -n ${MAX_STEPS:-} ]]; then
    EXTRA+=(--max_steps "$MAX_STEPS" --save_strategy no --load_best_model_at_end false)
fi
# SEED drives head initialisation, dropout masks and batch composition. data_seed is set
# alongside it so batch composition actually changes -- Trainer falls back to `seed` only
# when data_seed is unset, and leaving it pinned would make a "seed sweep" vary the head
# init while every run saw identical batches.
[[ -n ${SEED:-} ]] && EXTRA+=(--seed "$SEED" --data_seed "$SEED")

exec mpiexec \
    --envall \
    --pmi=pmix \
    -n "$TOTAL_XPUS" \
    --ppn "$XPUS_PER_HOST" \
    --cpu-bind depth --depth "${CPU_DEPTH:-8}" \
    --hostfile="$PBS_NODEFILE" \
    /usr/bin/env bash -c '
        set -euo pipefail
        export RANK="${PMIX_RANK:-${PALS_RANKID:-${PMI_RANK:-}}}"
        [[ -n $RANK ]] || { echo "launcher provided no rank" >&2; exit 2; }
        export WORLD_SIZE="$MSDELTA_WORLD_SIZE"
        export LOCAL_RANK="${PALS_LOCAL_RANKID:-${MPI_LOCALRANKID:-$((RANK % MSDELTA_XPUS_PER_HOST))}}"
        export LOCAL_WORLD_SIZE="$MSDELTA_XPUS_PER_HOST"
        exec "$@"
    ' _ "$VENV_DIR/bin/python" -m "$MODULE" \
        --args_file "$ARGS_FILE" \
        --run_name "$RUN_NAME" \
        --output_dir "$RUN_DIR" \
        "${EXTRA[@]}" \
    2>&1 | tee "$LOG_DIR/train.log"
