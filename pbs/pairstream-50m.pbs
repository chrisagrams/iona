#!/bin/bash
# Self-contained launcher for the pair-stream architecture experiment.
#
#   cd /path/to/msdelta && qsub pbs/pairstream-50m.pbs
#
# Everything below is set here rather than on the qsub command line. Edit the two
# ==== EDIT ME ==== values once, then submit with no flags.
#
# Defaults to a SHORT SMOKE RUN (debug queue, 2 nodes, 1 hour, 200 steps, probes off)
# because the first thing you want from a new architecture is proof that it starts.
# See "FULL RUN" at the bottom for the switch.

#PBS -N msdelta-pairstream-50m
#PBS -A UIC-HPC
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o pbs/logs/

set -euo pipefail


export http_proxy="http://proxy.alcf.anl.gov:3128"
export https_proxy="http://proxy.alcf.anl.gov:3128"
export ftp_proxy="http://proxy.alcf.anl.gov:3128"

# ==== EDIT ME ====================================================================
# Also set `#PBS -A` above to the same project name.
PROJECT_NAME=UIC-HPC
CHECKPOINT_ROOT=/eagle/${PROJECT_NAME}/${USER}/msdelta
# =================================================================================

REPO_DIR=${PBS_O_WORKDIR:-$PWD}

export ARGS_FILE=configs/msdelta-pairstream-50m/training.args
export CHECKPOINT_DIR=${CHECKPOINT_ROOT}/checkpoints
export HF_HOME=${CHECKPOINT_ROOT}/huggingface
export GLOBAL_BATCH_SIZE=512

# ---- smoke | full -------------------------------------------------------------
# NOTE: this only controls the training arguments. The queue and walltime are #PBS
# directives, read by qsub before this script runs, so they must be edited above:
#   smoke -> #PBS -q debug        #PBS -l walltime=01:00:00
#   full  -> #PBS -q preemptable  #PBS -l walltime=12:00:00
RUN_MODE=${RUN_MODE:-full}

if [[ $RUN_MODE == smoke ]]; then
    # A few hundred steps with the expensive probes off and no torch.compile.
    # torch.compile is off because K varies per batch and the pair stream adds
    # shape-dependent ops -- get the architecture working before adding that variable.
    # Uses the small LOCAL dataset in data/smoke (a few symlinked shards) instead of
    # the Hub repo -- otherwise the job spends its whole walltime downloading ~80 GB
    # before a single training step runs. Build it with: bash pbs/make_smoke_data.sh
    export EXTRA_ARGS="--dataset_root data/smoke --dataset_repo_id= --num_validation_files 1 --preprocessing_num_workers 8 --max_steps 200 --torch_compile false --probe_steps 50 --probe_num_spectra 500 --bias_curve_steps 100 --denoise_steps 0 --eval_steps 50 --save_steps 100 --logging_steps 10 --validation_batches 5 --replicate_retrieval_repo= --run_name msdelta-pairstream-50m-smoke"
elif [[ $RUN_MODE == full ]]; then
    # Everything comes from the args file: 56250 steps, full probe schedule,
    # torch_compile true. Only the run name is pinned here.
    export EXTRA_ARGS="--run_name msdelta-pairstream-50m"
else
    echo "ERROR: RUN_MODE must be 'smoke' or 'full', got '$RUN_MODE'" >&2
    exit 2
fi

cd "$REPO_DIR"

# Validate BEFORE creating anything, so a misconfigured project gives a clear message
# rather than a permission error from mkdir.
if [[ $PROJECT_NAME == PROJECT ]]; then
    echo "ERROR: set PROJECT_NAME and '#PBS -A' to your ALCF project." >&2
    exit 2
fi
if [[ ! -f $REPO_DIR/$ARGS_FILE ]]; then
    echo "ERROR: args file not found: $REPO_DIR/$ARGS_FILE" >&2
    exit 2
fi
if [[ ! -x $REPO_DIR/.venv/bin/python ]]; then
    echo "ERROR: no venv at $REPO_DIR/.venv -- run pbs/setup_venv.sh on a login node." >&2
    exit 2
fi
"$REPO_DIR/.venv/bin/python" -c \
    "from msdelta.model.experiments.pair_stream import MSDeltaPairStreamForPreTraining" \
    || { echo "ERROR: variant not importable -- re-run 'uv sync' on a login node." >&2; exit 2; }

# Chained-run support (see pbs/chain_debug.sh). The inner launcher derives a fresh
# output dir per job from $PBS_JOBID, which would scatter checkpoints across jobs and
# make resume impossible. Pin it, and save often enough that a walltime kill loses little.
if [[ -n ${CHAIN_OUTPUT_DIR:-} ]]; then
    EXTRA_ARGS="${EXTRA_ARGS:-} --output_dir $CHAIN_OUTPUT_DIR"
    EXTRA_ARGS="$EXTRA_ARGS --save_steps ${CHAIN_SAVE_STEPS:-500} --save_total_limit 3"
    # Must match pbs/prep_data.sh: datasets caches .map results per num_proc, so a
    # different worker count silently re-runs the whole preprocessing pass.
    EXTRA_ARGS="$EXTRA_ARGS --preprocessing_num_workers ${CHAIN_PREPROC_WORKERS:-24}"
    # Every chained job re-pays torch.compile on restart, and K varies per batch, so
    # compile is off by default here. Set CHAIN_TORCH_COMPILE=true to try it.
    EXTRA_ARGS="$EXTRA_ARGS --torch_compile ${CHAIN_TORCH_COMPILE:-false}"
    export EXTRA_ARGS
    echo "chained run  : output_dir=$CHAIN_OUTPUT_DIR resume=${RESUME_FROM_CHECKPOINT:-<none>}"
fi

mkdir -p "$REPO_DIR/pbs/logs" "$CHECKPOINT_DIR" "$HF_HOME"

echo "=== msdelta pair-stream experiment ==="
echo "repo        : $REPO_DIR"
echo "args file   : $ARGS_FILE"
echo "checkpoints : $CHECKPOINT_DIR"
echo "extra args  : ${EXTRA_ARGS:-<none>}"
echo

exec bash "$REPO_DIR/pbs/polaris-pretrain.pbs"

# ---------------------------------------------------------------------------------
# FULL RUN
#   1. Change the directives above to a queue that allows your node count and walltime:
#        #PBS -q preemptable          (1-10 nodes, long walltime)
#        #PBS -l select=2:system=polaris
#        #PBS -l walltime=12:00:00
#      Polaris queue policies change -- check the current ALCF docs for node-count and
#      walltime limits before submitting, since `prod` has a node-count floor.
#   2. Drop EXTRA_ARGS entirely (or keep only --run_name) so the args file's
#      --max_steps 56250 and the full probe schedule are used.
#   3. Re-enable --torch_compile true in the args file once the smoke run is clean.
#
# RESUMING
#   export RESUME_FROM_CHECKPOINT=/eagle/.../checkpoint-10000   (read by the inner script)
#
# BASELINE CONTROL
#   Copy this file, set ARGS_FILE=configs/msdelta-base-50m/training.args and a distinct
#   --run_name. The two models are parameter-matched to 0.03%, so differences in
#   eval/loss and align/* are attributable to the architecture.
# ---------------------------------------------------------------------------------
