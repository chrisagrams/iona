#!/bin/bash -l
# Submit from the repository root and provide scheduler policy through qsub.
# Example (8 XPU tiles per node, global batch size 512):
# qsub -A PROJECT -q QUEUE \
#   -l select=2 -l place=scatter -l walltime=12:00:00 \
#   -l filesystems=home:flare:daos_user_fs -j oe -o /path/to/pbs/logs \
#   -v ARGS_FILE=configs/iona-base-200m/training.args,DAOS_POOL=POOL,DAOS_CONT=msdelta-training,LOG_ROOT=/flare/PROJECT/msdelta-runs,XPUS_PER_HOST=8,GLOBAL_BATCH_SIZE=512 \
#   pbs/aurora-pretrain.pbs
# HF_HOME defaults to /tmp/$DAOS_POOL/$DAOS_CONT/hf-cache. Copy the entire
# preprocessing HF_HOME there, including datasets/msdelta-preprocessed and
# datasets/msdelta-probes. Override HF_HOME to use another mounted location.
# Set LOG_ROOT to the Flare base directory. Logs and W&B files are created at
# $LOG_ROOT/$RUN_NAME/logs; RUN_NAME defaults to the configured run name + job ID.
# LOG_DIR may override the complete path. Checkpoints remain in DAOS.
# Set RESUME_FROM_CHECKPOINT=latest with a stable RUN_NAME to resume the highest
# complete checkpoint-N directory. The job saves and exits cleanly before its
# requested walltime; CHECKPOINT_MARGIN_SECONDS defaults to 15 minutes.
#
# Posttraining defaults to asynchronous sidecars on the global-rank-zero host.
# DENOISE_XPU_TILES=4,5 and RETRIEVAL_XPU_TILES=10,11 use both tiles per spare card.
# Export comma-separated lists before qsub; commas also delimit qsub -v entries.
# Set PROBE_EXECUTION=inline to retain synchronous probes, or off to disable heads.
# Telegraf is no longer provided on Aurora; set TELEGRAF_BIN to a portable
# binary on a shared filesystem.
# The launch follows the ALCF Aurora PyTorch DDP guidance:
# https://docs.alcf.anl.gov/aurora/data-science/frameworks/pytorch/

source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/aurora-env.sh"

IONA_HOSTS=$JOB_HOSTS exec bash "$REPO_DIR/pbs/aurora-run.sh"
