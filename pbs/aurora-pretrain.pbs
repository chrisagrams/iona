#!/bin/bash -l
# Submit from the repository root and provide scheduler policy through qsub.
# Example (8 XPU tiles per node, global batch size 512):
# qsub -A PROJECT -q QUEUE \
#   -l select=2 -l place=scatter -l walltime=12:00:00 \
#   -l filesystems=home:flare -j oe -o /path/to/pbs/logs \
#   -v ARGS_FILE=configs/msdelta-base-200m/training.args,CHECKPOINT_DIR=/flare/PROJECT/checkpoints,HF_HOME=/flare/PROJECT/hf,XPUS_PER_HOST=8,GLOBAL_BATCH_SIZE=512 \
#   pbs/aurora-pretrain.pbs
#
# The launch follows the ALCF Aurora DeepSpeed MPICH guidance:
# https://docs.alcf.anl.gov/aurora/data-science/frameworks/deepspeed/

module load frameworks

set -euo pipefail

REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
ARGS_FILE=${ARGS_FILE:?set ARGS_FILE to an MSDelta training args file}
CHECKPOINT_DIR=${CHECKPOINT_DIR:?set CHECKPOINT_DIR for Trainer checkpoints}
DEEPSPEED_CONFIG=${DEEPSPEED_CONFIG:-$REPO_DIR/configs/deepspeed-zero2-aurora.json}

if [[ $ARGS_FILE != /* ]]; then
    ARGS_FILE=$REPO_DIR/$ARGS_FILE
fi
if [[ $CHECKPOINT_DIR != /* ]]; then
    CHECKPOINT_DIR=$REPO_DIR/$CHECKPOINT_DIR
fi
if [[ $DEEPSPEED_CONFIG != /* ]]; then
    DEEPSPEED_CONFIG=$REPO_DIR/$DEEPSPEED_CONFIG
fi
if [[ ! -f $ARGS_FILE ]]; then
    echo "arguments file not found: $ARGS_FILE" >&2
    exit 2
fi
if [[ ! -f $DEEPSPEED_CONFIG ]]; then
    echo "DeepSpeed config not found: $DEEPSPEED_CONFIG" >&2
    exit 2
fi
if [[ ! -x $VENV_DIR/bin/python ]]; then
    echo "Python interpreter not found: $VENV_DIR/bin/python" >&2
    exit 2
fi
if ! command -v mpiexec >/dev/null 2>&1; then
    echo "mpiexec is required for an Aurora launch" >&2
    exit 2
fi
if [[ ! -f ${PBS_NODEFILE:-} ]]; then
    echo "PBS_NODEFILE is required for an Aurora launch" >&2
    exit 2
fi

JOB_ID=${PBS_JOBID:-local}
JOB_ID=${JOB_ID%%.*}
mapfile -t CONFIG_VALUES < <(
    "$VENV_DIR/bin/python" - "$ARGS_FILE" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
tokens = path.read_text().split()


def argument(name: str, default: str | None = None) -> str | None:
    values = [tokens[index + 1] for index, token in enumerate(tokens[:-1]) if token == name]
    return values[-1] if values else default


run_name = argument("--run_name", path.parent.name)
micro_batch_size = int(argument("--per_device_train_batch_size", "0"))
wandb_project = argument("--wandb_project", "")
if micro_batch_size < 1:
    raise ValueError("--per_device_train_batch_size must be a positive integer")
print(run_name)
print(micro_batch_size)
print(wandb_project)
PY
)
CONFIG_RUN_NAME=${CONFIG_VALUES[0]}
MICRO_BATCH_SIZE=${MICRO_BATCH_SIZE:-${CONFIG_VALUES[1]}}
CONFIG_WANDB_PROJECT=${CONFIG_VALUES[2]}
RUN_NAME=${RUN_NAME:-${CONFIG_RUN_NAME}-${JOB_ID}}
RUN_DIR=$CHECKPOINT_DIR/$RUN_NAME
LOG_DIR=${LOG_DIR:-$RUN_DIR/logs}
HF_HOME=${HF_HOME:-$CHECKPOINT_DIR/huggingface}
mkdir -p "$RUN_DIR" "$LOG_DIR" "$HF_HOME"

cd "$REPO_DIR"
NODE_LIST=$RUN_DIR/pbs-nodes
awk '!seen[$0]++ {print $0}' "$PBS_NODEFILE" >"$NODE_LIST"
NUM_HOSTS=$(wc -l <"$NODE_LIST")
XPUS_PER_HOST=${XPUS_PER_HOST:-8}
if ((XPUS_PER_HOST < 1 || XPUS_PER_HOST > 12)); then
    echo "XPUS_PER_HOST must be between 1 and 12 on Aurora" >&2
    exit 2
fi
TOTAL_XPUS=$((NUM_HOSTS * XPUS_PER_HOST))

GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-512}
DENOMINATOR=$((MICRO_BATCH_SIZE * TOTAL_XPUS))
if ((GLOBAL_BATCH_SIZE % DENOMINATOR != 0)); then
    echo "global batch size $GLOBAL_BATCH_SIZE is not divisible by" \
        "$MICRO_BATCH_SIZE micro-batch x $TOTAL_XPUS XPUs" >&2
    exit 2
fi
GRADIENT_ACCUMULATION_STEPS=$((GLOBAL_BATCH_SIZE / DENOMINATOR))
if ((GRADIENT_ACCUMULATION_STEPS < 1)); then
    echo "global batch size $GLOBAL_BATCH_SIZE is smaller than one distributed micro-batch" >&2
    exit 2
fi

ZE_AFFINITY_MASK=$(seq -s, 0 $((XPUS_PER_HOST - 1)))
export ZE_AFFINITY_MASK
export ONEAPI_DEVICE_SELECTOR=${ONEAPI_DEVICE_SELECTOR:-level_zero:gpu}
export SYCL_DEVICE_FILTER=${SYCL_DEVICE_FILTER:-level_zero:gpu}
export ZE_FLAT_DEVICE_HIERARCHY=${ZE_FLAT_DEVICE_HIERARCHY:-FLAT}

VISIBLE_XPUS=$("$VENV_DIR/bin/python" -c 'import torch; print(torch.xpu.device_count())')
if [[ $VISIBLE_XPUS != "$XPUS_PER_HOST" ]]; then
    echo "expected $XPUS_PER_HOST visible XPU tiles, found $VISIBLE_XPUS" >&2
    exit 2
fi

echo "$(date -Is) job=${PBS_JOBID:-local} hosts=$NUM_HOSTS xpus_per_host=$XPUS_PER_HOST total_xpus=$TOTAL_XPUS global_batch=$GLOBAL_BATCH_SIZE micro_batch=$MICRO_BATCH_SIZE accumulation=$GRADIENT_ACCUMULATION_STEPS run=$RUN_NAME"
echo "nodes:"
sed 's/^/  /' "$NODE_LIST"
"$VENV_DIR/bin/python" -c 'import deepspeed, torch; print(f"torch={torch.__version__} deepspeed={deepspeed.__version__} xccl={torch.distributed.is_xccl_available()}")'

export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-4}
export CCL_PROCESS_LAUNCHER=pmix
export CCL_ATL_TRANSPORT=mpi
export CCL_KVS_MODE=mpi
export FI_MR_CACHE_MONITOR=${FI_MR_CACHE_MONITOR:-userfaultfd}
export CCL_ZE_IPC=${CCL_ZE_IPC:-0}
export CCL_ZE_IPC_EXCHANGE=${CCL_ZE_IPC_EXCHANGE:-sockets}
export HF_HOME
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export MASTER_ADDR=${MASTER_ADDR:-$(head -n 1 "$NODE_LIST")}
export MASTER_PORT=${MASTER_PORT:-29500}
export MSDELTA_XPUS_PER_HOST=$XPUS_PER_HOST
export MSDELTA_WORLD_SIZE=$TOTAL_XPUS

ALCF_PROXY=${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTP_PROXY=${HTTP_PROXY:-$ALCF_PROXY}
export HTTPS_PROXY=${HTTPS_PROXY:-$ALCF_PROXY}
export http_proxy=${http_proxy:-$ALCF_PROXY}
export https_proxy=${https_proxy:-$ALCF_PROXY}
export ftp_proxy=${ftp_proxy:-$ALCF_PROXY}
export no_proxy=${no_proxy:-admin,localhost,*.cm.aurora.alcf.anl.gov,aurora-*,*.aurora.alcf.anl.gov,*.alcf.anl.gov}
export NO_PROXY=${NO_PROXY:-$no_proxy}

export WANDB_DIR=${WANDB_DIR:-$LOG_DIR}
export WANDB_RESUME=${WANDB_RESUME:-allow}
export WANDB_RUN_ID=${WANDB_RUN_ID:-$RUN_NAME}
export WANDB_PROJECT=${WANDB_PROJECT:-$CONFIG_WANDB_PROJECT}

TRAIN_ARGS=(
    --args_file "$ARGS_FILE"
    --deepspeed "$DEEPSPEED_CONFIG"
    --run_name "$RUN_NAME"
    --output_dir "$RUN_DIR"
    --per_device_train_batch_size "$MICRO_BATCH_SIZE"
    --gradient_accumulation_steps "$GRADIENT_ACCUMULATION_STEPS"
    --ddp_backend xccl
)
if [[ -n ${RESUME_FROM_CHECKPOINT:-} ]]; then
    TRAIN_ARGS+=(--resume_from_checkpoint "$RESUME_FROM_CHECKPOINT")
fi

exec mpiexec \
    --verbose \
    --envall \
    --pmi=pmix \
    -n "$TOTAL_XPUS" \
    --ppn "$XPUS_PER_HOST" \
    --cpu-bind "${CPU_BIND:-none}" \
    --hostfile="$PBS_NODEFILE" \
    /usr/bin/env \
    bash -c '
        export RANK="${PMIX_RANK:-${PALS_RANKID:-${PMI_RANK:-}}}"
        if [[ -z $RANK ]]; then
            echo "Aurora launcher did not provide PMIX_RANK, PALS_RANKID, or PMI_RANK" >&2
            exit 2
        fi
        export WORLD_SIZE="$MSDELTA_WORLD_SIZE"
        export LOCAL_RANK="${PALS_LOCAL_RANKID:-${MPI_LOCALRANKID:-$((RANK % MSDELTA_XPUS_PER_HOST))}}"
        export LOCAL_WORLD_SIZE="$MSDELTA_XPUS_PER_HOST"
        exec "$@"
    ' bash \
    "$VENV_DIR/bin/python" \
    -m msdelta.train \
    "${TRAIN_ARGS[@]}" \
    >"$LOG_DIR/train-$JOB_ID.out" \
    2>"$LOG_DIR/train-$JOB_ID.err"
