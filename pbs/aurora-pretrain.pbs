#!/bin/bash -l
# Submit from the repository root and provide scheduler policy through qsub.
# Example (8 XPU tiles per node, global batch size 512):
# qsub -A PROJECT -q QUEUE \
#   -l select=2 -l place=scatter -l walltime=12:00:00 \
#   -l filesystems=home:flare:daos_user_fs -j oe -o /path/to/pbs/logs \
#   -v IONA_ARGS_FILE=configs/iona-base-200m/training.args,IONA_DAOS_POOL=POOL,IONA_DAOS_CONT=msdelta-training,IONA_LOG_ROOT=/flare/PROJECT/msdelta-runs,IONA_DEVICES_PER_HOST=8,IONA_GLOBAL_BATCH_SIZE=512 \
#   pbs/aurora-pretrain.pbs
# Settings are IONA_* variables, read and validated by iona.env.AuroraPlatform;
# see that class for every option and its default. Commonly used:
# IONA_HF_HOME defaults to /tmp/$IONA_DAOS_POOL/$IONA_DAOS_CONT/hf-cache. Copy the
# entire preprocessing HF_HOME there, including datasets/msdelta-preprocessed and
# datasets/msdelta-probes.
# Logs and W&B files are created at $IONA_LOG_ROOT/$RUN_NAME/logs; the run name
# defaults to the configured run name + job ID, IONA_RUN_NAME overrides it, and
# IONA_LOG_DIR overrides the complete log path. Checkpoints remain in DAOS.
# Set IONA_RESUME_FROM_CHECKPOINT=latest with a stable IONA_RUN_NAME to resume the
# highest complete checkpoint-N directory. The job saves and exits cleanly before
# its requested walltime; IONA_CHECKPOINT_MARGIN_SECONDS defaults to 15 minutes.
#
# Posttraining defaults to asynchronous sidecars on the global-rank-zero host.
# IONA_DENOISE_XPU_TILES=4,5 and IONA_RETRIEVAL_XPU_TILES=10,11 use both tiles per
# spare card. Export comma-separated lists before qsub; commas also delimit qsub -v
# entries. Set IONA_PROBE_EXECUTION=inline to retain synchronous probes, or off to
# disable heads.
# Telegraf is no longer provided on Aurora; set IONA_TELEGRAF_BIN to a portable
# binary on a shared filesystem.

module use /soft/modulefiles
module load daos
module load frameworks/2026.1.0
module load xpu-smi

set -euo pipefail

cd "${PBS_O_WORKDIR:-$PWD}"
exec "${IONA_VENV_DIR:-$PWD/.venv}/bin/python" -m iona.launch --platform aurora pretrain
