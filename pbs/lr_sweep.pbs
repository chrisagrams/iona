#!/bin/bash
#PBS -N mkbxl_lrsweep
#PBS -A FRAME-IDP
#PBS -q debug-scaling
#PBS -l select=4:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# LR-range test for the XL model at global batch 1024 (the B_simple point) —
# Stage A of the LR × grad_clip co-tune. Four cells, ONE PER NODE, each a full
# 4-GPU DDP run of configs/massivekb_xl.yaml with a flat (constant-after-warmup)
# LR over a short 4000-step horizon (~45 min at 0.63 s/step, inside the 1h
# debug-scaling cap). grad_clip is held loose (5.0) so the clip is a spike valve,
# not firing every step — that isolates the LR effect. Stage B (clip refinement
# at the winning LR) is a follow-up submit with CLIPS varying and one LR.
#
# This is NOT a wandb sweep: each cell is an independent CLI-override launch that
# logs its own run to project msfound as mkbxl-sweep-lr<lr>-clip<clip>-<jobid>.
# Compare them in the wandb UI or with the ranking snippet in the chat.
#
# Grid (LR brackets the two scaling rules from Spark's known-good 1.3e-4 @ 512):
#   1.0e-4  Spark's value held constant (the "don't scale up at B_simple" bet)
#   1.3e-4  Spark-512 known-good, unscaled
#   1.8e-4  current √2 scaling (the by-the-book choice that over-clips at clip=1)
#   2.6e-4  linear scaling — deliberate divergence probe
#
# Read on completion (at a fixed sample budget, e.g. step 4000): eval/loss +
# its last-2k slope, and grad_norm health (median pre-clip norm, %clipped, max).
# Pick the highest LR that stays stable (grad_norm bounded, eval/loss still
# falling) then confirm it at ~12-15k steps before a full 28k run.
#
# Pre-req: pbs/setup_venv.sh once; HF cache pre-populated on eagle.
# Launch:  qsub pbs/lr_sweep.pbs

set -euo pipefail

REPO=/home/cgrams/msdelta
cd "$REPO"

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

# One (lr, grad_clip) cell per node. Four cells, four nodes.
LRS=(1.0e-4 1.3e-4 1.8e-4 2.6e-4)
CLIP=5.0

# Unique node hostnames from the PBS allocation (PBS_NODEFILE may list a host
# more than once depending on chunk cpus; dedupe to one line per node).
mapfile -t NODES < <(sort -u "$PBS_NODEFILE")
echo "$(date -Is) job=$PBS_JOBID nodes=${#NODES[@]} cells=${#LRS[@]}"
printf '  node: %s\n' "${NODES[@]}"

if (( ${#NODES[@]} < ${#LRS[@]} )); then
    echo "ERROR: need ${#LRS[@]} nodes, got ${#NODES[@]}" >&2
    exit 2
fi

# Launch each cell on its node in the background via mpiexec (Cray PALS) rather
# than raw ssh: node-to-node ssh is not permitted inside a Polaris job (key/
# hostbased auth fails -> "Permission denied", exit 255). PALS mpiexec is the
# sanctioned launcher on this machine, and multiple concurrent single-node
# mpiexec invocations against disjoint --hosts coexist fine in one allocation.
# `--np 1 --ppn 1 --hosts $node` places exactly one shell on the target node;
# that shell's torchrun (--standalone, node-local NCCL rendezvous) then spawns
# the 4 per-GPU ranks itself. The cell script lives on shared home, visible on
# every node. PALS sets PMI_*/PALS_* env (not RANK/WORLD_SIZE), so it does not
# collide with the RANK/WORLD_SIZE that torchrun exports to its children.
PIDS=()
for i in "${!LRS[@]}"; do
    lr=${LRS[$i]}
    node=${NODES[$i]}
    echo "$(date -Is) -> node=$node lr=$lr clip=$CLIP"
    mpiexec --np 1 --ppn 1 --hosts "$node" -- \
        bash "$REPO/pbs/_run_sweep_cell.sh" "$lr" "$CLIP" "$JOBID" &
    PIDS+=($!)
done

# Wait on all cells; exit nonzero if any failed so the job is flagged.
set +e
FAIL=0
for i in "${!LRS[@]}"; do
    wait "${PIDS[$i]}"; rc=$?
    echo "$(date -Is) cell lr=${LRS[$i]} exit=$rc"
    (( rc != 0 )) && FAIL=1
done
exit $FAIL
