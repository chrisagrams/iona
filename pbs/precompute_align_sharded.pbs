#!/bin/bash -l
# Build an alignment teacher-embedding cache on all 12 tiles of one node.
#
#   qsub -q debug -l select=1 -l walltime=01:00:00 \
#        -v ARGS_FILE=configs/finetune-align-100k-50m/training.args,PRETRAINED_PATH=...,TARGET_CACHE=/lus/.../align-targets-x \
#        pbs/precompute_align_sharded.pbs
#
# precompute_align --stage prepare (one process: flatten + preprocess, saved to _flat),
# then --stage shard on each tile (contiguous shard i of 12), then --stage merge, which
# concatenates the shards in order -- the exact cache the one-tile build would write.
# Refuses to overwrite an existing cache.

#PBS -N msdelta-precompute-sh
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
ARGS_FILE=${ARGS_FILE:?set ARGS_FILE}
PRETRAINED_PATH=${PRETRAINED_PATH:?set PRETRAINED_PATH}
TARGET_CACHE=${TARGET_CACHE:?set TARGET_CACHE}
SHARDS=${SHARDS:-12}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
PROJECT=${PROJECT:-UIC-HPC}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/$PROJECT/$USER/msdelta}
[[ -d $TARGET_CACHE/train ]] && { echo "$TARGET_CACHE/train exists; refusing to overwrite" >&2; exit 2; }

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u

export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
# Default for the single-process stages; each shard overrides it with its own tile.
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}
PY="$VENV_DIR/bin/python"
run() { "$PY" -m msdelta.precompute_align --args_file "$ARGS_FILE" --pretrained_path "$PRETRAINED_PATH" \
        --target_cache "$TARGET_CACHE" --num_shards "$SHARDS" "$@"; }

if [[ ! -d $TARGET_CACHE/_flat/train ]]; then
    echo "=== $(date -Is) prepare"
    run --stage prepare || { echo "prepare failed" >&2; exit 1; }
fi
echo "=== $(date -Is) shard x $SHARDS"
pids=()
for (( i = 0; i < SHARDS; i++ )); do
    if [[ -d $TARGET_CACHE/_shards/validation/$(printf %03d $i) ]]; then continue; fi
    ZE_AFFINITY_MASK=$i run --stage shard --shard_index "$i" --pad_spectra_to "${PAD_TO:-512}" \
        > "$TARGET_CACHE/.shard$i.log" 2>&1 &
    pids+=($!)
done
failed=0
for p in "${pids[@]}"; do wait "$p" || failed=1; done
grep -h "\[precompute\] shard" "$TARGET_CACHE"/.shard*.log
(( failed )) && { echo "a shard failed" >&2; tail -5 "$TARGET_CACHE"/.shard*.log; exit 1; }
echo "=== $(date -Is) merge"
run --stage merge || { echo "merge failed" >&2; exit 1; }
echo "=== $(date -Is) done"
