#!/bin/bash
#PBS -N msdelta_v14_smoke
#PBS -A FRAME-IDP
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:20:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# v14 smoke — single A100, debug queue. Runs configs/v14_smoke.yaml (tiny
# model, 50 steps) to exercise evaluation and parameter diagnostics on GPU. If this
# finishes clean and logs align/* and retrieval/* at steps 20 and 40, the
# 20h capacity sweep (pbs/v14_capacity.pbs) is safe to launch.
#
# SMOKE is intentionally left unset so the config's evaluation cadence is
# preserved.
#
# Pre-req: pbs/setup_venv.sh run once on the login node.

set -euo pipefail

REPO=/home/cgrams/msdelta
cd "$REPO"

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

echo "$(date -Is) job=$PBS_JOBID host=$(hostname)"
nvidia-smi -L | sed "s/^/  /"

# Single GPU (0); _run_tier.sh execs msdelta-train and redirects its
# stdout/err to $LOGDIR/v14_smoke.{out,err}.
bash "$REPO/pbs/_run_tier.sh" configs/v14_smoke.yaml 0
rc=$?
echo "$(date -Is) v14_smoke exit=$rc"
echo "  → check pbs/logs/${JOBID}/v14_smoke.out for the step 20 & 40 'align:' / 'retrieval:' lines"
exit $rc
