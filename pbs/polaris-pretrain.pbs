#!/bin/bash
# Submit from the repository root and provide scheduler policy through qsub.
# Example:
# qsub -A PROJECT -q QUEUE \
#   -l select=2:system=polaris -l place=scatter -l walltime=12:00:00 \
#   -l filesystems=home:eagle -j oe -o /path/to/pbs/logs \
#   -v ARGS_FILE=configs/msdelta-base-200m/training.args,CHECKPOINT_DIR=/eagle/PROJECT/checkpoints,HF_HOME=/eagle/PROJECT/hf \
#   pbs/polaris-pretrain.pbs
# Launch pattern follows the ALCF Polaris DeepSpeed guide's MPICH option:
# https://docs.alcf.anl.gov/polaris/data-science/frameworks/deepspeed/

set -euo pipefail

REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
ARGS_FILE=${ARGS_FILE:?set ARGS_FILE to an MSDelta training args file}
CHECKPOINT_DIR=${CHECKPOINT_DIR:?set CHECKPOINT_DIR for Trainer checkpoints}

if [[ $ARGS_FILE != /* ]]; then
    ARGS_FILE=$REPO_DIR/$ARGS_FILE
fi
if [[ $CHECKPOINT_DIR != /* ]]; then
    CHECKPOINT_DIR=$REPO_DIR/$CHECKPOINT_DIR
fi
if [[ ! -f $ARGS_FILE ]]; then
    echo "arguments file not found: $ARGS_FILE" >&2
    exit 2
fi
if [[ ! -x $VENV_DIR/bin/python ]]; then
    echo "Python interpreter not found: $VENV_DIR/bin/python" >&2
    exit 2
fi
if ! command -v mpiexec >/dev/null 2>&1; then
    echo "mpiexec is required for a multinode Polaris launch" >&2
    exit 2
fi
if [[ ! -f ${PBS_NODEFILE:-} ]]; then
    echo "PBS_NODEFILE is required for a Polaris DeepSpeed launch" >&2
    exit 2
fi

JOB_ID=${PBS_JOBID:-local}
JOB_ID=${JOB_ID%%.*}
mapfile -t CONFIG_VALUES < <(
    "$VENV_DIR/bin/python" - "$ARGS_FILE" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
tokens = path.read_text().split()

def argument(name: str, default: str | None = None) -> str | None:
    values = [tokens[index + 1] for index, token in enumerate(tokens[:-1]) if token == name]
    return values[-1] if values else default

run_name = argument("--run_name", path.parent.name)
micro_batch_size = int(argument("--per_device_train_batch_size", "0"))
if micro_batch_size < 1:
    raise ValueError("--per_device_train_batch_size must be a positive integer")
if argument("--deepspeed") is None:
    raise ValueError("--deepspeed must be configured for this launcher")
print(run_name)
print(micro_batch_size)
PY
)
CONFIG_RUN_NAME=${CONFIG_VALUES[0]}
MICRO_BATCH_SIZE=${CONFIG_VALUES[1]}
RUN_NAME=${CONFIG_RUN_NAME}-${JOB_ID}
RUN_DIR=$CHECKPOINT_DIR/$RUN_NAME
LOG_DIR=${LOG_DIR:-$RUN_DIR/logs}
HF_HOME=${HF_HOME:-$CHECKPOINT_DIR/huggingface}
mkdir -p "$RUN_DIR" "$LOG_DIR" "$HF_HOME"

cd "$REPO_DIR"
GPUS_PER_HOST=${GPUS_PER_HOST:-$(nvidia-smi -L | wc -l)}
if ((GPUS_PER_HOST < 1)); then
    echo "no GPUs detected" >&2
    exit 2
fi
NODE_LIST=$RUN_DIR/pbs-nodes
awk '!seen[$0]++ {print $0}' "$PBS_NODEFILE" >"$NODE_LIST"
NUM_HOSTS=$(wc -l <"$NODE_LIST")
TOTAL_GPUS=$((NUM_HOSTS * GPUS_PER_HOST))

GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-512}
DENOMINATOR=$((MICRO_BATCH_SIZE * TOTAL_GPUS))
if ((GLOBAL_BATCH_SIZE % DENOMINATOR != 0)); then
    echo "global batch size $GLOBAL_BATCH_SIZE is not divisible by" \
        "$MICRO_BATCH_SIZE micro-batch x $TOTAL_GPUS GPUs" >&2
    exit 2
fi
GRADIENT_ACCUMULATION_STEPS=$((GLOBAL_BATCH_SIZE / DENOMINATOR))
if ((GRADIENT_ACCUMULATION_STEPS < 1)); then
    echo "global batch size $GLOBAL_BATCH_SIZE is smaller than one distributed micro-batch" >&2
    exit 2
fi

echo "$(date -Is) job=${PBS_JOBID:-local} hosts=$NUM_HOSTS gpus_per_host=$GPUS_PER_HOST total_gpus=$TOTAL_GPUS global_batch=$GLOBAL_BATCH_SIZE accumulation=$GRADIENT_ACCUMULATION_STEPS run=$RUN_NAME"
echo "nodes:"
sed 's/^/  /' "$NODE_LIST"
nvidia-smi -L | sed 's/^/  /'

export OMP_NUM_THREADS=${OMP_NUM_THREADS:-2}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-2}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-2}
export CC=gcc
export CXX=g++
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}
export HF_HOME
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-0}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
export MASTER_ADDR=${MASTER_ADDR:-$(head -n 1 "$NODE_LIST")}
export MASTER_PORT=${MASTER_PORT:-29500}
export MSDELTA_GPUS_PER_HOST=$GPUS_PER_HOST

ALCF_PROXY=${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTP_PROXY=${HTTP_PROXY:-$ALCF_PROXY}
export HTTPS_PROXY=${HTTPS_PROXY:-$ALCF_PROXY}
export http_proxy=${http_proxy:-$ALCF_PROXY}
export https_proxy=${https_proxy:-$ALCF_PROXY}
export ftp_proxy=${ftp_proxy:-$ALCF_PROXY}
export no_proxy=${no_proxy:-admin,polaris-adminvm-01,localhost,*.cm.polaris.alcf.anl.gov,polaris-*,*.polaris.alcf.anl.gov,*.alcf.anl.gov}
export NO_PROXY=${NO_PROXY:-$no_proxy}

export WANDB_DIR=${WANDB_DIR:-$LOG_DIR}
export WANDB_RESUME=${WANDB_RESUME:-allow}
export WANDB_RUN_ID=${WANDB_RUN_ID:-$RUN_NAME}

TRAIN_ARGS=(
    --args_file "$ARGS_FILE"
    --run_name "$RUN_NAME"
    --output_dir "$RUN_DIR"
    --gradient_accumulation_steps "$GRADIENT_ACCUMULATION_STEPS"
)
if [[ -n ${RESUME_FROM_CHECKPOINT:-} ]]; then
    TRAIN_ARGS+=(--resume_from_checkpoint "$RESUME_FROM_CHECKPOINT")
fi

exec mpiexec \
    --verbose \
    --envall \
    -n "$TOTAL_GPUS" \
    --ppn "$GPUS_PER_HOST" \
    --cpu-bind none \
    --hostfile="$PBS_NODEFILE" \
    /usr/bin/env \
    bash -c '
        export RANK="$PMI_RANK"
        export WORLD_SIZE="$PMI_SIZE"
        export LOCAL_RANK="${MPI_LOCALRANKID:-$((RANK % MSDELTA_GPUS_PER_HOST))}"
        export LOCAL_WORLD_SIZE="${MPI_LOCALNRANKS:-$MSDELTA_GPUS_PER_HOST}"
        exec "$@"
    ' bash \
    "$VENV_DIR/bin/python" \
    -m msdelta.train \
    "${TRAIN_ARGS[@]}" \
    >"$LOG_DIR/train-$JOB_ID.out" \
    2>"$LOG_DIR/train-$JOB_ID.err"
