#!/bin/bash -l
# Score alignment students on the ms-contrastive-100k test split (msdelta.eval_align_test).
#
#   qsub -q debug-scaling -l select=1 -l walltime=00:30:00 \
#        -v RUNS="dir1 dir2",CACHE=/lus/.../align-targets-x,ARGS_FILE=configs/.../training.args \
#        pbs/eval_align_test.pbs
#
# One student per tile, in parallel; outputs to results/finetune/align/.

#PBS -N msdelta-evalalign
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
RUNS=${RUNS:?set RUNS to space-separated alignment run dirs}
CACHE=${CACHE:?set CACHE}
ARGS_FILE=${ARGS_FILE:?set ARGS_FILE}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/${PROJECT:-UIC-HPC}/$USER/msdelta}
DATA=${DATA:-$SCRATCH_ROOT/eval-data/ms-contrastive-100k-test-mp512}

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Run from a frozen copy of the code (pbs/lib/code_snapshot.sh): branch switches and
# edits in the checkout cannot affect this job once it has started.
source "$REPO_DIR/pbs/lib/code_snapshot.sh"
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}

mkdir -p results/finetune/align
i=0; pids=()
for run in $RUNS; do
    name=$(basename "$run")
    ZE_AFFINITY_MASK=$i "$VENV_DIR/bin/python" -m msdelta.eval_align_test --run "$run" \
        --cache "$CACHE" --args_file "$ARGS_FILE" --data "$DATA" \
        --out "results/finetune/align/test_$name.json" > "results/finetune/align/.test_$name.log" 2>&1 &
    pids+=($!); i=$((i + 1))
done
failed=0
for p in "${pids[@]}"; do wait "$p" || failed=1; done
for run in $RUNS; do
    name=$(basename "$run"); echo "== $name"
    grep -E '"crossmodal/(hit@1|hit@5|mrr|n_candidates)"|"teacher_spectrum/MAP@R"' "results/finetune/align/.test_$name.log" \
        || tail -5 "results/finetune/align/.test_$name.log"
done
exit $failed
