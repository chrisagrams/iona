#!/bin/bash -l
# Validate the handoff rescorer (msdelta.psm_rerank): tests; train the GLOBAL model on the 8
# development runs (A2 embedding + lab features); score 16 HELD-OUT HCT116 runs: global,
# per-run, per-run without the embedding (control). The trained model -> $T/model-iona-rerank-400m.
#PBS -N rerank-handoff
#PBS -A UIC-HPC
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o /home/khuss/code/msdelta/pbs/logs/
set -uo pipefail
cd ${REPO_DIR:-/home/khuss/code/msdelta}
S=/lus/flare/projects/UIC-HPC/khuss/msdelta; T=$S/rerank-psm/handoff
set +u; source /usr/share/lmod/lmod/init/bash; module load frameworks/2025.3.1; set -u
source pbs/load_keys.sh
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZE_FLAT_DEVICE_HIERARCHY=FLAT ZE_AFFINITY_MASK=0
export PYTHONPATH=$PWD OMP_NUM_THREADS=32 HF_HOME=$S/huggingface HF_HUB_OFFLINE=0 HF_DATASETS_OFFLINE=1
ALCF_PROXY=http://proxy.alcf.anl.gov:3128; export HTTP_PROXY=$ALCF_PROXY HTTPS_PROXY=$ALCF_PROXY http_proxy=$ALCF_PROXY https_proxy=$ALCF_PROXY
export no_proxy="admin,localhost,*.cm.aurora.alcf.anl.gov,aurora-*,*.aurora.alcf.anl.gov,*.alcf.anl.gov,127.0.0.1"; export NO_PROXY=$no_proxy
PY=.venv/bin/python
echo "=== $(date -Is) tests"
$PY -m pytest -q -p no:cacheprovider tests/test_psm_rerank.py tests/test_rerank_r4.py -rfE > $T/.tests.log 2>&1
rc=$?; grep -E "^(FAILED|ERROR)|[0-9]+ (passed|failed)" $T/.tests.log | tail -5; [[ $rc == 0 ]] || { echo "tests failed"; exit 1; }
echo "=== $(date -Is) lab features"
LAB=$($PY - $(ls $T/train_rows $T/heldout_rows | grep parquet | sed 's/.parquet//') <<'PY'
import sys
from pathlib import Path
from huggingface_hub import HfApi, hf_hub_download
from msdelta.rerank_psm_fdr import LAB_REVISION
R = "Gaolaboratory/psm-rerank-hek-hct116"
files = [f for f in HfApi().list_repo_files(R, repo_type="dataset", revision=LAB_REVISION) if f.startswith("features/")]
root = None
for run in sys.argv[1:]:
    hit = [f for f in files if f.endswith(f"/{run}.parquet")]
    root = Path(hf_hub_download(R, hit[0], repo_type="dataset", revision=LAB_REVISION)).parent.parent
print(root)
PY
) || exit 1
echo "=== $(date -Is) train global on 8 runs"
$PY -m msdelta.psm_rerank train --rows $T/train_rows --labfeat $LAB --out $T/model-iona-rerank-400m || exit 1
echo "=== $(date -Is) held-out HCT116 (16 runs)"
$PY -m msdelta.psm_rerank score --mode global --model $T/model-iona-rerank-400m --rows $T/heldout_rows --labfeat $LAB --out $T/heldout_global.parquet
$PY -m msdelta.psm_rerank score --mode perrun --rows $T/heldout_rows --labfeat $LAB --out $T/heldout_perrun.parquet
$PY -m msdelta.psm_rerank score --mode perrun --no-embedding --rows $T/heldout_rows --labfeat $LAB --out $T/heldout_perrun_noemb.parquet
echo "=== $(date -Is) done"
