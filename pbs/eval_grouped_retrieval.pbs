#!/bin/bash -l
# Score saved contrastive encoders on ms-contrastive-100k's held-out split. No training.
#
#   qsub -q debug -l select=1 -l walltime=01:00:00 \
#        -v MODELS=sweeps/arms/grouped100k_models.txt pbs/eval_grouped_retrieval.pbs
#
# 1. the unit tests for the chunked metric and the flattening -- abort if they fail;
# 2. prepare the flattened, preprocessed split ONCE (skipped if DATA already exists);
# 3. one scoring process per tile, each taking every 12th model;
# 4. a table of every model scored so far.
# Per-model JSONs are skipped when present, so a timed-out job is resumed by resubmitting.

#PBS -N msdelta-evalgrp
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
MODELS=${MODELS:?set MODELS to a models file}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
PROJECT=${PROJECT:-UIC-HPC}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/$PROJECT/$USER/msdelta}
SPLIT=${SPLIT:-test}
DATA=${DATA:-$SCRATCH_ROOT/eval-data/ms-contrastive-100k-$SPLIT-mp512}
PROCESSOR=${PROCESSOR:-/flare/UIC-HPC/khuss/msdelta/pretrained/msdelta-50m-production-01-checkpoint-220000}
OUT_DIR=${OUT_DIR:-results/raw/finetune/contrastive/grouped100k-$SPLIT}
SHARDS=${SHARDS:-12}

set +u
source /usr/share/lmod/lmod/init/bash
module load "${FRAMEWORKS_MODULE:-frameworks/2025.3.1}"
set -u

export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
# Default for the single-process steps; each scoring shard overrides it with its own tile.
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Run from a frozen copy of the code (pbs/lib/code_snapshot.sh): branch switches and
# edits in the checkout cannot affect this job once it has started.
source "$REPO_DIR/pbs/lib/code_snapshot.sh"
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}
PY="$VENV_DIR/bin/python"

echo "=== $(date -Is) tests"
ZE_AFFINITY_MASK=0 "$PY" -m pytest -q tests/test_grouped_retrieval.py \
    || { echo "unit tests failed; not scoring" >&2; exit 1; }

if [[ ! -d $DATA ]]; then
    echo "=== $(date -Is) prepare $DATA"
    mkdir -p "$(dirname "$DATA")"
    ZE_AFFINITY_MASK=0 "$PY" -m msdelta.eval_grouped_retrieval prepare \
        --out-data "$DATA" --processor "$PROCESSOR" --split "$SPLIT" \
        || { echo "prepare failed" >&2; exit 1; }
fi
cat "$DATA/PREPARED.json"

echo "=== $(date -Is) score on $SHARDS tiles"
mkdir -p "$OUT_DIR"
pids=()
for (( i = 0; i < SHARDS; i++ )); do
    ZE_AFFINITY_MASK=$i "$PY" -m msdelta.eval_grouped_retrieval score \
        --data "$DATA" --models "$MODELS" --out-dir "$OUT_DIR" \
        --shard "$i" --num-shards "$SHARDS" > "$OUT_DIR/.shard$i.log" 2>&1 &
    pids+=($!)
done
failed=0
for i in "${!pids[@]}"; do
    wait "${pids[$i]}" || { echo "  shard $i failed:"; tail -5 "$OUT_DIR/.shard$i.log"; failed=1; }
done
cat "$OUT_DIR"/.shard*.log | grep -E "MAP@R|skipping|skipped|Error" || true

echo "=== $(date -Is) table"
"$PY" - "$OUT_DIR" "$MODELS" <<'EOF'
import json, sys
from pathlib import Path
out, models = Path(sys.argv[1]), sys.argv[2]
names = [l.split()[0] for l in Path(models).read_text().splitlines()
         if l.strip() and not l.startswith("#")]
# Standard since 2026-09-27: exp MAP@R without a filter, with 20 ppm and isotope-tolerant
# 20 ppm filters, on the queries the 20 ppm filter passes (Fbar) and fails (F).
# lib: library search (C25), experimental queries vs consensus-only library, Hit@1
# unfiltered / 20 ppm / iso 20 ppm and unfiltered MRR; dashes when not scored.
def g(m, k):
    v = m.get(k)
    return f"{v:7.4f}" if isinstance(v, (int, float)) else f"{'-':>7s}"
print(f"{'model':38s} {'all':>7s} {'exp':>7s} {'Hit@1':>7s} {'queries':>7s} | "
      f"{'20ppm':>7s} {'iso':>7s} | F: {'open':>7s} {'20ppm':>7s} {'iso':>7s} | "
      f"Fbar: {'open':>7s} {'20ppm':>7s} | {'F n':>6s} {'loss':>6s} {'rescue':>6s} | "
      f"lib: {'open':>7s} {'20ppm':>7s} {'iso':>7s} {'MRR':>7s}")
for n in names:
    f = out / f"{n}.json"
    if not f.exists():
        print(f"{n:38s} {'(missing)':>9s}"); continue
    m = json.loads(f.read_text())["metrics"]
    e = "experimental/"
    print(f"{n:38s} {g(m, 'all/MAP@R')} {g(m, e + 'MAP@R')} {g(m, e + 'Hit@1')} "
          f"{int(m[e + 'queries']):7d} | {g(m, e + '20ppm/full/MAP@R')} {g(m, e + 'iso20ppm/full/MAP@R')} | "
          f"F: {g(m, e + 'open/F/MAP@R')} {g(m, e + '20ppm/F/MAP@R')} {g(m, e + 'iso20ppm/F/MAP@R')} | "
          f"Fbar: {g(m, e + 'open/Fbar/MAP@R')} {g(m, e + '20ppm/Fbar/MAP@R')} | "
          f"{int(m.get(e + 'open/F/n', 0)):6d} {g(m, e + '20ppm/net_loss')[1:]} {g(m, e + 'rescue')[1:]} | "
          f"lib: {g(m, 'library/Hit@1')} {g(m, 'library/20ppm/full/Hit@1')} "
          f"{g(m, 'library/iso20ppm/full/Hit@1')} {g(m, 'library/MRR')}")
EOF
exit $failed
