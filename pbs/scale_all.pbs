#!/bin/bash
#PBS -N msdelta_scale
#PBS -A FRAME-IDP
#PBS -q capacity
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=18:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o /home/cgrams/msdelta/pbs/logs/
#
# Capacity-sweep msdelta v11 — one Polaris node, 4× A100-40GB, one model
# per GPU (scale_S on GPU0, M on 1, L on 2, XL on 3). Each model is the
# m/z-free + per-head bias + masked-intensity baseline (see docs/EXPERIMENTS.md
# §v11); equal data exposure ~12.8M spectra per tier. Read on completion:
# count of correction-surviving chemical heads vs capacity.
#
# Data:    /eagle/UIC-HPC/cgrams/msbench-datasets/consensus_100M/
# Configs: configs/scale_{S,M,L,XL}.yaml (data.root spliced at launch)
# Logs:    pbs/logs/<jobid>/<tier>.{out,err}
# Runs:    runs/scale_<tier>_<jobid>/
#
# Pre-req: pbs/setup_venv.sh has been run once on the login node.

set -euo pipefail

REPO=/home/cgrams/msdelta
cd "$REPO"

JOBID=${PBS_JOBID%%.*}
JOBID=${JOBID:-local}
LOGDIR=$REPO/pbs/logs/${JOBID}
mkdir -p "$LOGDIR"

echo "$(date -Is) job=$PBS_JOBID host=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
nvidia-smi -L | sed "s/^/  /"

# Launch one tier per local GPU. All four run concurrently on the same
# node; CUDA_VISIBLE_DEVICES is set inside _run_tier.sh. Backgrounding
# (&) keeps the four processes parallel; we wait on each PID so the job
# exits nonzero if any tier failed.
CONFIGS=(configs/scale_S.yaml configs/scale_M.yaml configs/scale_L.yaml configs/scale_XL.yaml)
PIDS=()
for i in "${!CONFIGS[@]}"; do
    cfg=${CONFIGS[$i]}
    gpu=$i
    bash "$REPO/pbs/_run_tier.sh" "$cfg" "$gpu" &
    PIDS+=($!)
    echo "$(date -Is) launched cfg=$cfg gpu=$gpu pid=$!"
done

set +e
FAIL=0
for i in "${!CONFIGS[@]}"; do
    cfg=${CONFIGS[$i]}
    wait "${PIDS[$i]}"
    rc=$?
    echo "$(date -Is) cfg=$cfg exit=$rc"
    if [[ $rc -ne 0 ]]; then
        FAIL=1
    fi
done

exit $FAIL
