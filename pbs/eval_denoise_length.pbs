#!/bin/bash -l
# Denoise metrics by spectrum length, beyond the 512-peak training cap (msdelta.eval_denoise_length).
#
#   qsub -q debug-scaling -l select=1 -l walltime=01:00:00 \
#        -v MODELS=sweeps/arms/denoise_length_models.txt pbs/eval_denoise_length.pbs
#
# One model per tile. Per-model JSONs are skipped when present, so a timeout resumes.

#PBS -N msdelta-denoise-len
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
MODELS=${MODELS:?set MODELS}
OUT_DIR=${OUT_DIR:-results/raw/finetune/denoise/by-length}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/${PROJECT:-UIC-HPC}/$USER/msdelta}
set +u
source /usr/share/lmod/lmod/init/bash
source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/lib/load_frameworks.sh"
set -u
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Run from a frozen copy of the code (pbs/lib/code_snapshot.sh): branch switches and
# edits in the checkout cannot affect this job once it has started.
source "$REPO_DIR/pbs/lib/code_snapshot.sh"
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}
mkdir -p "$OUT_DIR"
n=$(grep -cv '^#' "$MODELS")
pids=()
for (( i = 0; i < n; i++ )); do
    ZE_AFFINITY_MASK=$i "$VENV_DIR/bin/python" -m msdelta.eval_denoise_length --models "$MODELS" \
        --out-dir "$OUT_DIR" --shard "$i" --num-shards "$n" > "$OUT_DIR/.shard$i.log" 2>&1 &
    pids+=($!)
done
failed=0
for p in "${pids[@]}"; do wait "$p" || failed=1; done
grep -h "AUROC\|skipped\|Error" "$OUT_DIR"/.shard*.log
exit $failed
