#!/bin/bash -l
# Zero-shot, per-layer retrieval of frozen pretrained encoders on the 100k test.
#
#   qsub -q debug-scaling -l select=1 -l walltime=01:00:00 \
#        -v MODELS=sweeps/arms/zeroshot_layers_models.txt pbs/eval_zeroshot_layers.pbs
#
# One model per tile (up to 12). Per-model JSONs are skipped when present.
# All-but-the-top (see msdelta/eval_zeroshot_layers.py):
#   -v MODELS=...,ABTT=1:2:4:8:16:32     (':' -- qsub -v splits on commas)
# fits on FIT_DATA (default: the prepared 10k-analyte train sample) and writes to
# zeroshot-layers-abtt/, so the plain per-layer results are never skipped or mixed.

#PBS -N msdelta-zeroshot
#PBS -A UIC-HPC
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o pbs/logs/

set -uo pipefail
REPO_DIR=${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}
cd "$REPO_DIR"
MODELS=${MODELS:?set MODELS}
OUT_DIR=${OUT_DIR:-results/raw/finetune/contrastive/zeroshot-layers${ABTT:+-abtt}}
VENV_DIR=${VENV_DIR:-$REPO_DIR/.venv}
SCRATCH_ROOT=${SCRATCH_ROOT:-/lus/flare/projects/${PROJECT:-UIC-HPC}/$USER/msdelta}
DATA=${DATA:-$SCRATCH_ROOT/eval-data/ms-contrastive-100k-test-mp512}
ABTT=${ABTT:-}
FIT_DATA=${FIT_DATA:-$SCRATCH_ROOT/eval-data/ms-contrastive-100k-train10k-mp512}
EXTRA=()
[ -n "$ABTT" ] && EXTRA=(--abtt "$ABTT" --fit-data "$FIT_DATA")
set +u
source /usr/share/lmod/lmod/init/bash
source "${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}/pbs/lib/load_frameworks.sh"
set -u
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTHONPATH=$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}
# Run from a frozen copy of the code (pbs/lib/code_snapshot.sh): branch switches and
# edits in the checkout cannot affect this job once it has started.
source "$REPO_DIR/pbs/lib/code_snapshot.sh"
export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/huggingface}
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export HF_DATASETS_OFFLINE=${HF_DATASETS_OFFLINE:-1}
mkdir -p "$OUT_DIR"
n=$(grep -cv '^#' "$MODELS")
pids=()
for (( i = 0; i < n; i++ )); do
    ZE_AFFINITY_MASK=$i "$VENV_DIR/bin/python" -m msdelta.eval_zeroshot_layers --models "$MODELS" \
        --data "$DATA" --out-dir "$OUT_DIR" --shard "$i" --num-shards "$n" "${EXTRA[@]}" \
        > "$OUT_DIR/.shard$i.log" 2>&1 &
    pids+=($!)
done
failed=0
for p in "${pids[@]}"; do wait "$p" || failed=1; done
grep -h "s): final\|Error" "$OUT_DIR"/.shard*.log
exit $failed
